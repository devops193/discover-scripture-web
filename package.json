{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "export:product": "node scripts/export-product.mjs --r2-candidate && node scripts/prepare-r2-public-candidate.mjs && node scripts/product-manifest.mjs --write",
    "verify:product-artifacts": "node scripts/product-manifest.mjs",
    "verify:viewport": "node scripts/check-shared-runtime.mjs",
    "dev": "vinext dev",
    "build": "vinext build",
    "build:netlify": "next build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.4",
    "@cloudflare/workers-types": "5.20261001.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "react-dom-product": "npm:react-dom@^19.2.3",
    "react-native-web": "^0.21.3",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.1",
    "vite": "8.0.16",
    "wrangler": "4.146.0"
  },
  "overrides": {
    "satori": { "fflate": "0.7.5" }
  },
  "type": "module"
}
