{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":26,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":26,"verse_ordinal":335,"verse_start":1,"verse_end":1,"verse_label":"1","text":"Judge me, LORD, for I have walked in my integrity. I have trusted also in the LORD without wavering.","is_omitted":0,"source_line":1169},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":26,"verse_ordinal":336,"verse_start":2,"verse_end":2,"verse_label":"2","text":"Examine me, LORD, and prove me. Try my heart and my mind.","is_omitted":0,"source_line":1172},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":26,"verse_ordinal":337,"verse_start":3,"verse_end":3,"verse_label":"3","text":"For your loving kindness is before my eyes. I have walked in your truth.","is_omitted":0,"source_line":1175},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":26,"verse_ordinal":338,"verse_start":4,"verse_end":4,"verse_label":"4","text":"I have not sat with deceitful men, neither will I go in with hypocrites.","is_omitted":0,"source_line":1178},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":26,"verse_ordinal":339,"verse_start":5,"verse_end":5,"verse_label":"5","text":"I hate the assembly of evildoers, and will not sit with the wicked.","is_omitted":0,"source_line":1181},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":26,"verse_ordinal":340,"verse_start":6,"verse_end":6,"verse_label":"6","text":"I will wash my hands in innocence, so I will go about your altar, LORD,","is_omitted":0,"source_line":1184},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":26,"verse_ordinal":341,"verse_start":7,"verse_end":7,"verse_label":"7","text":"that I may make the voice of thanksgiving to be heard and tell of all your wondrous deeds.","is_omitted":0,"source_line":1187},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":26,"verse_ordinal":342,"verse_start":8,"verse_end":8,"verse_label":"8","text":"LORD, I love the habitation of your house, the place where your glory dwells.","is_omitted":0,"source_line":1190},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":26,"verse_ordinal":343,"verse_start":9,"verse_end":9,"verse_label":"9","text":"Don’t gather my soul with sinners, nor my life with bloodthirsty men","is_omitted":0,"source_line":1193},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":26,"verse_ordinal":344,"verse_start":10,"verse_end":10,"verse_label":"10","text":"in whose hands is wickedness; their right hand is full of bribes.","is_omitted":0,"source_line":1196},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":26,"verse_ordinal":345,"verse_start":11,"verse_end":11,"verse_label":"11","text":"But as for me, I will walk in my integrity. Redeem me, and be merciful to me.","is_omitted":0,"source_line":1200},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":26,"verse_ordinal":346,"verse_start":12,"verse_end":12,"verse_label":"12","text":"My foot stands in an even place. In the congregations I will bless the LORD.","is_omitted":0,"source_line":1203}]}