{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":114,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":114,"verse_ordinal":1884,"verse_start":1,"verse_end":1,"verse_label":"1","text":"When Israel went out of Egypt, the house of Jacob from a people of foreign language,","is_omitted":0,"source_line":6429},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":114,"verse_ordinal":1885,"verse_start":2,"verse_end":2,"verse_label":"2","text":"Judah became his sanctuary, Israel his dominion.","is_omitted":0,"source_line":6432},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":114,"verse_ordinal":1886,"verse_start":3,"verse_end":3,"verse_label":"3","text":"The sea saw it, and fled. The Jordan was driven back.","is_omitted":0,"source_line":6435},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":114,"verse_ordinal":1887,"verse_start":4,"verse_end":4,"verse_label":"4","text":"The mountains skipped like rams, the little hills like lambs.","is_omitted":0,"source_line":6438},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":114,"verse_ordinal":1888,"verse_start":5,"verse_end":5,"verse_label":"5","text":"What was it, you sea, that you fled? You Jordan, that you turned back?","is_omitted":0,"source_line":6441},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":114,"verse_ordinal":1889,"verse_start":6,"verse_end":6,"verse_label":"6","text":"You mountains, that you skipped like rams? You little hills, like lambs?","is_omitted":0,"source_line":6444},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":114,"verse_ordinal":1890,"verse_start":7,"verse_end":7,"verse_label":"7","text":"Tremble, you earth, at the presence of the Lord, at the presence of the God of Jacob,","is_omitted":0,"source_line":6447},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":114,"verse_ordinal":1891,"verse_start":8,"verse_end":8,"verse_label":"8","text":"who turned the rock into a pool of water, the flint into a spring of waters.","is_omitted":0,"source_line":6450}]}