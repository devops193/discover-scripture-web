{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":129,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":129,"verse_ordinal":2194,"verse_start":1,"verse_end":1,"verse_label":"1","text":"Many times they have afflicted me from my youth up. Let Israel now say:","is_omitted":0,"source_line":7418},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":129,"verse_ordinal":2195,"verse_start":2,"verse_end":2,"verse_label":"2","text":"many times they have afflicted me from my youth up, yet they have not prevailed against me.","is_omitted":0,"source_line":7421},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":129,"verse_ordinal":2196,"verse_start":3,"verse_end":3,"verse_label":"3","text":"The plowers plowed on my back. They made their furrows long.","is_omitted":0,"source_line":7424},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":129,"verse_ordinal":2197,"verse_start":4,"verse_end":4,"verse_label":"4","text":"The LORD is righteous. He has cut apart the cords of the wicked.","is_omitted":0,"source_line":7427},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":129,"verse_ordinal":2198,"verse_start":5,"verse_end":5,"verse_label":"5","text":"Let them be disappointed and turned backward, all those who hate Zion.","is_omitted":0,"source_line":7430},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":129,"verse_ordinal":2199,"verse_start":6,"verse_end":6,"verse_label":"6","text":"Let them be as the grass on the housetops, which withers before it grows up,","is_omitted":0,"source_line":7433},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":129,"verse_ordinal":2200,"verse_start":7,"verse_end":7,"verse_label":"7","text":"with which the reaper doesn’t fill his hand, nor he who binds sheaves, his bosom.","is_omitted":0,"source_line":7436},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":129,"verse_ordinal":2201,"verse_start":8,"verse_end":8,"verse_label":"8","text":"Neither do those who go by say, “The blessing of the LORD be on you. We bless you in the LORD’s name.”","is_omitted":0,"source_line":7439}]}