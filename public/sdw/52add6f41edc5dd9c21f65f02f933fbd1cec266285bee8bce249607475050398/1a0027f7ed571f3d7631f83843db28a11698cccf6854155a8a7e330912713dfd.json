{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":122,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":122,"verse_ordinal":2151,"verse_start":1,"verse_end":1,"verse_label":"1","text":"I was glad when they said to me, “Let’s go to the LORD’s house!”","is_omitted":0,"source_line":7270},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":122,"verse_ordinal":2152,"verse_start":2,"verse_end":2,"verse_label":"2","text":"Our feet are standing within your gates, Jerusalem!","is_omitted":0,"source_line":7273},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":122,"verse_ordinal":2153,"verse_start":3,"verse_end":3,"verse_label":"3","text":"Jerusalem is built as a city that is compact together,","is_omitted":0,"source_line":7275},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":122,"verse_ordinal":2154,"verse_start":4,"verse_end":4,"verse_label":"4","text":"where the tribes go up, even the LORD’s tribes, according to an ordinance for Israel, to give thanks to the LORD’s name.","is_omitted":0,"source_line":7277},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":122,"verse_ordinal":2155,"verse_start":5,"verse_end":5,"verse_label":"5","text":"For there are set thrones for judgment, the thrones of David’s house.","is_omitted":0,"source_line":7281},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":122,"verse_ordinal":2156,"verse_start":6,"verse_end":6,"verse_label":"6","text":"Pray for the peace of Jerusalem. Those who love you will prosper.","is_omitted":0,"source_line":7284},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":122,"verse_ordinal":2157,"verse_start":7,"verse_end":7,"verse_label":"7","text":"Peace be within your walls, and prosperity within your palaces.","is_omitted":0,"source_line":7287},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":122,"verse_ordinal":2158,"verse_start":8,"verse_end":8,"verse_label":"8","text":"For my brothers’ and companions’ sakes, I will now say, “Peace be within you.”","is_omitted":0,"source_line":7290},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":122,"verse_ordinal":2159,"verse_start":9,"verse_end":9,"verse_label":"9","text":"For the sake of the house of the LORD our God, I will seek your good.","is_omitted":0,"source_line":7293}]}