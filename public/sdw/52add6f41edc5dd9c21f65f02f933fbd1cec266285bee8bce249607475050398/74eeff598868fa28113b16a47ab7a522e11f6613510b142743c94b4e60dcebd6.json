{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":121,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":121,"verse_ordinal":2143,"verse_start":1,"verse_end":1,"verse_label":"1","text":"I will lift up my eyes to the hills. Where does my help come from?","is_omitted":0,"source_line":7243},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":121,"verse_ordinal":2144,"verse_start":2,"verse_end":2,"verse_label":"2","text":"My help comes from the LORD, who made heaven and earth.","is_omitted":0,"source_line":7246},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":121,"verse_ordinal":2145,"verse_start":3,"verse_end":3,"verse_label":"3","text":"He will not allow your foot to be moved. He who keeps you will not slumber.","is_omitted":0,"source_line":7250},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":121,"verse_ordinal":2146,"verse_start":4,"verse_end":4,"verse_label":"4","text":"Behold, he who keeps Israel will neither slumber nor sleep.","is_omitted":0,"source_line":7253},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":121,"verse_ordinal":2147,"verse_start":5,"verse_end":5,"verse_label":"5","text":"The LORD is your keeper. The LORD is your shade on your right hand.","is_omitted":0,"source_line":7256},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":121,"verse_ordinal":2148,"verse_start":6,"verse_end":6,"verse_label":"6","text":"The sun will not harm you by day, nor the moon by night.","is_omitted":0,"source_line":7259},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":121,"verse_ordinal":2149,"verse_start":7,"verse_end":7,"verse_label":"7","text":"The LORD will keep you from all evil. He will keep your soul.","is_omitted":0,"source_line":7262},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":121,"verse_ordinal":2150,"verse_start":8,"verse_end":8,"verse_label":"8","text":"The LORD will keep your going out and your coming in, from this time forward, and forever more.","is_omitted":0,"source_line":7265}]}