{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":82,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":82,"verse_ordinal":1295,"verse_start":1,"verse_end":1,"verse_label":"1","text":"God presides in the great assembly. He judges among the gods.","is_omitted":0,"source_line":4490},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":82,"verse_ordinal":1296,"verse_start":2,"verse_end":2,"verse_label":"2","text":"“How long will you judge unjustly, and show partiality to the wicked?” Selah.","is_omitted":0,"source_line":4493},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":82,"verse_ordinal":1297,"verse_start":3,"verse_end":3,"verse_label":"3","text":"“Defend the weak, the poor, and the fatherless. Maintain the rights of the poor and oppressed.","is_omitted":0,"source_line":4497},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":82,"verse_ordinal":1298,"verse_start":4,"verse_end":4,"verse_label":"4","text":"Rescue the weak and needy. Deliver them out of the hand of the wicked.”","is_omitted":0,"source_line":4500},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":82,"verse_ordinal":1299,"verse_start":5,"verse_end":5,"verse_label":"5","text":"They don’t know, neither do they understand. They walk back and forth in darkness. All the foundations of the earth are shaken.","is_omitted":0,"source_line":4503},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":82,"verse_ordinal":1300,"verse_start":6,"verse_end":6,"verse_label":"6","text":"I said, “You are gods, all of you are sons of the Most High.","is_omitted":0,"source_line":4507},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":82,"verse_ordinal":1301,"verse_start":7,"verse_end":7,"verse_label":"7","text":"Nevertheless you shall die like men, and fall like one of the rulers.”","is_omitted":0,"source_line":4510},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":82,"verse_ordinal":1302,"verse_start":8,"verse_end":8,"verse_label":"8","text":"Arise, God, judge the earth, for you inherit all of the nations.","is_omitted":0,"source_line":4513}]}