{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:ps2","chapter":1,"verses":[{"translation_id":"engwebu","book_id":"engwebu:ps2","chapter":1,"verse_ordinal":1,"verse_start":1,"verse_end":1,"verse_label":"1","text":"I was small among my brothers, and youngest in my father’s house. I tended my father’s sheep.","is_omitted":0,"source_line":12},{"translation_id":"engwebu","book_id":"engwebu:ps2","chapter":1,"verse_ordinal":2,"verse_start":2,"verse_end":2,"verse_label":"2","text":"My hands formed a musical instrument, and my fingers tuned a lyre.","is_omitted":0,"source_line":16},{"translation_id":"engwebu","book_id":"engwebu:ps2","chapter":1,"verse_ordinal":3,"verse_start":3,"verse_end":3,"verse_label":"3","text":"Who shall tell my Lord? The Lord himself, he himself hears.","is_omitted":0,"source_line":19},{"translation_id":"engwebu","book_id":"engwebu:ps2","chapter":1,"verse_ordinal":4,"verse_start":4,"verse_end":4,"verse_label":"4","text":"He sent forth his angel and took me from my father’s sheep, and he anointed me with his anointing oil.","is_omitted":0,"source_line":22},{"translation_id":"engwebu","book_id":"engwebu:ps2","chapter":1,"verse_ordinal":5,"verse_start":5,"verse_end":5,"verse_label":"5","text":"My brothers were handsome and tall; but the Lord didn’t take pleasure in them.","is_omitted":0,"source_line":25},{"translation_id":"engwebu","book_id":"engwebu:ps2","chapter":1,"verse_ordinal":6,"verse_start":6,"verse_end":6,"verse_label":"6","text":"I went out to meet the Philistine, and he cursed me by his idols.","is_omitted":0,"source_line":28},{"translation_id":"engwebu","book_id":"engwebu:ps2","chapter":1,"verse_ordinal":7,"verse_start":7,"verse_end":7,"verse_label":"7","text":"But I drew his own sword and beheaded him, and removed reproach from the children of Israel.","is_omitted":0,"source_line":31}]}