{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:lam","chapter":5,"verses":[{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":5,"verse_ordinal":133,"verse_start":1,"verse_end":1,"verse_label":"1","text":"Remember, LORD, what has come on us. Look, and see our reproach.","is_omitted":0,"source_line":649},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":5,"verse_ordinal":134,"verse_start":2,"verse_end":2,"verse_label":"2","text":"Our inheritance has been turned over to strangers, our houses to aliens.","is_omitted":0,"source_line":652},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":5,"verse_ordinal":135,"verse_start":3,"verse_end":3,"verse_label":"3","text":"We are orphans and fatherless. Our mothers are as widows.","is_omitted":0,"source_line":655},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":5,"verse_ordinal":136,"verse_start":4,"verse_end":4,"verse_label":"4","text":"We must pay for water to drink. Our wood is sold to us.","is_omitted":0,"source_line":658},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":5,"verse_ordinal":137,"verse_start":5,"verse_end":5,"verse_label":"5","text":"Our pursuers are on our necks. We are weary, and have no rest.","is_omitted":0,"source_line":661},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":5,"verse_ordinal":138,"verse_start":6,"verse_end":6,"verse_label":"6","text":"We have given our hands to the Egyptians, and to the Assyrians, to be satisfied with bread.","is_omitted":0,"source_line":664},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":5,"verse_ordinal":139,"verse_start":7,"verse_end":7,"verse_label":"7","text":"Our fathers sinned, and are no more. We have borne their iniquities.","is_omitted":0,"source_line":667},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":5,"verse_ordinal":140,"verse_start":8,"verse_end":8,"verse_label":"8","text":"Servants rule over us. There is no one to deliver us out of their hand.","is_omitted":0,"source_line":670},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":5,"verse_ordinal":141,"verse_start":9,"verse_end":9,"verse_label":"9","text":"We get our bread at the peril of our lives, because of the sword in the wilderness.","is_omitted":0,"source_line":673},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":5,"verse_ordinal":142,"verse_start":10,"verse_end":10,"verse_label":"10","text":"Our skin is black like an oven, because of the burning heat of famine.","is_omitted":0,"source_line":676},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":5,"verse_ordinal":143,"verse_start":11,"verse_end":11,"verse_label":"11","text":"They ravished the women in Zion, the virgins in the cities of Judah.","is_omitted":0,"source_line":679},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":5,"verse_ordinal":144,"verse_start":12,"verse_end":12,"verse_label":"12","text":"Princes were hanged up by their hands. The faces of elders were not honored.","is_omitted":0,"source_line":682},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":5,"verse_ordinal":145,"verse_start":13,"verse_end":13,"verse_label":"13","text":"The young men carry millstones. The children stumbled under loads of wood.","is_omitted":0,"source_line":685},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":5,"verse_ordinal":146,"verse_start":14,"verse_end":14,"verse_label":"14","text":"The elders have ceased from the gate, and the young men from their music.","is_omitted":0,"source_line":688},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":5,"verse_ordinal":147,"verse_start":15,"verse_end":15,"verse_label":"15","text":"The joy of our heart has ceased. Our dance is turned into mourning.","is_omitted":0,"source_line":691},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":5,"verse_ordinal":148,"verse_start":16,"verse_end":16,"verse_label":"16","text":"The crown has fallen from our head. Woe to us, for we have sinned!","is_omitted":0,"source_line":694},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":5,"verse_ordinal":149,"verse_start":17,"verse_end":17,"verse_label":"17","text":"For this our heart is faint. For these things our eyes are dim:","is_omitted":0,"source_line":697},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":5,"verse_ordinal":150,"verse_start":18,"verse_end":18,"verse_label":"18","text":"for the mountain of Zion, which is desolate. The foxes walk on it.","is_omitted":0,"source_line":700},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":5,"verse_ordinal":151,"verse_start":19,"verse_end":19,"verse_label":"19","text":"You, LORD, remain forever. Your throne is from generation to generation.","is_omitted":0,"source_line":704},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":5,"verse_ordinal":152,"verse_start":20,"verse_end":20,"verse_label":"20","text":"Why do you forget us forever, and forsake us for so long a time?","is_omitted":0,"source_line":707},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":5,"verse_ordinal":153,"verse_start":21,"verse_end":21,"verse_label":"21","text":"Turn us to yourself, LORD, and we will be turned. Renew our days as of old.","is_omitted":0,"source_line":710},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":5,"verse_ordinal":154,"verse_start":22,"verse_end":22,"verse_label":"22","text":"But you have utterly rejected us. You are very angry against us.","is_omitted":0,"source_line":713}]}