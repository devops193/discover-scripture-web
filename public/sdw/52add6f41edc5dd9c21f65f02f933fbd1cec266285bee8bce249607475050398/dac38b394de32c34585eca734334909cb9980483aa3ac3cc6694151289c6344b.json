{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":20,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":20,"verse_ordinal":244,"verse_start":1,"verse_end":1,"verse_label":"1","text":"May the LORD answer you in the day of trouble. May the name of the God of Jacob set you up on high,","is_omitted":0,"source_line":855},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":20,"verse_ordinal":245,"verse_start":2,"verse_end":2,"verse_label":"2","text":"send you help from the sanctuary, grant you support from Zion,","is_omitted":0,"source_line":858},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":20,"verse_ordinal":246,"verse_start":3,"verse_end":3,"verse_label":"3","text":"remember all your offerings, and accept your burned sacrifice. Selah.","is_omitted":0,"source_line":861},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":20,"verse_ordinal":247,"verse_start":4,"verse_end":4,"verse_label":"4","text":"May he grant you your heart’s desire, and fulfill all your counsel.","is_omitted":0,"source_line":864},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":20,"verse_ordinal":248,"verse_start":5,"verse_end":5,"verse_label":"5","text":"We will triumph in your salvation. In the name of our God, we will set up our banners. May the LORD grant all your requests.","is_omitted":0,"source_line":867},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":20,"verse_ordinal":249,"verse_start":6,"verse_end":6,"verse_label":"6","text":"Now I know that the LORD saves his anointed. He will answer him from his holy heaven, with the saving strength of his right hand.","is_omitted":0,"source_line":871},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":20,"verse_ordinal":250,"verse_start":7,"verse_end":7,"verse_label":"7","text":"Some trust in chariots, and some in horses, but we trust in the name of the LORD our God.","is_omitted":0,"source_line":875},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":20,"verse_ordinal":251,"verse_start":8,"verse_end":8,"verse_label":"8","text":"They are bowed down and fallen, but we rise up, and stand upright.","is_omitted":0,"source_line":878},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":20,"verse_ordinal":252,"verse_start":9,"verse_end":9,"verse_label":"9","text":"Save, LORD! Let the King answer us when we call!","is_omitted":0,"source_line":881}]}