{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":113,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":113,"verse_ordinal":1875,"verse_start":1,"verse_end":1,"verse_label":"1","text":"Praise the LORD! Praise, you servants of the LORD, praise the LORD’s name.","is_omitted":0,"source_line":6400},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":113,"verse_ordinal":1876,"verse_start":2,"verse_end":2,"verse_label":"2","text":"Blessed be the LORD’s name, from this time forward and forever more.","is_omitted":0,"source_line":6404},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":113,"verse_ordinal":1877,"verse_start":3,"verse_end":3,"verse_label":"3","text":"From the rising of the sun to its going down, the LORD’s name is to be praised.","is_omitted":0,"source_line":6407},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":113,"verse_ordinal":1878,"verse_start":4,"verse_end":4,"verse_label":"4","text":"The LORD is high above all nations, his glory above the heavens.","is_omitted":0,"source_line":6410},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":113,"verse_ordinal":1879,"verse_start":5,"verse_end":5,"verse_label":"5","text":"Who is like the LORD, our God, who has his seat on high,","is_omitted":0,"source_line":6413},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":113,"verse_ordinal":1880,"verse_start":6,"verse_end":6,"verse_label":"6","text":"who stoops down to see in heaven and on the earth?","is_omitted":0,"source_line":6416},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":113,"verse_ordinal":1881,"verse_start":7,"verse_end":7,"verse_label":"7","text":"He raises up the poor out of the dust, and lifts up the needy from the ash heap,","is_omitted":0,"source_line":6418},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":113,"verse_ordinal":1882,"verse_start":8,"verse_end":8,"verse_label":"8","text":"that he may set him with princes, even with the princes of his people.","is_omitted":0,"source_line":6421},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":113,"verse_ordinal":1883,"verse_start":9,"verse_end":9,"verse_label":"9","text":"He settles the barren woman in her home as a joyful mother of children. Praise the LORD!","is_omitted":0,"source_line":6424}]}