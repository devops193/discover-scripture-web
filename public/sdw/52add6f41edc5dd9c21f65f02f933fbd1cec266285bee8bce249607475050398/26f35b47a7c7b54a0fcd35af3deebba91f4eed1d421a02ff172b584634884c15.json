{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":67,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":67,"verse_ordinal":955,"verse_start":1,"verse_end":1,"verse_label":"1","text":"May God be merciful to us, bless us, and cause his face to shine on us. Selah.","is_omitted":0,"source_line":3341},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":67,"verse_ordinal":956,"verse_start":2,"verse_end":2,"verse_label":"2","text":"That your way may be known on earth, and your salvation among all nations,","is_omitted":0,"source_line":3344},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":67,"verse_ordinal":957,"verse_start":3,"verse_end":3,"verse_label":"3","text":"let the peoples praise you, God. Let all the peoples praise you.","is_omitted":0,"source_line":3347},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":67,"verse_ordinal":958,"verse_start":4,"verse_end":4,"verse_label":"4","text":"Oh let the nations be glad and sing for joy, for you will judge the peoples with equity, and govern the nations on earth. Selah.","is_omitted":0,"source_line":3350},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":67,"verse_ordinal":959,"verse_start":5,"verse_end":5,"verse_label":"5","text":"Let the peoples praise you, God. Let all the peoples praise you.","is_omitted":0,"source_line":3354},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":67,"verse_ordinal":960,"verse_start":6,"verse_end":6,"verse_label":"6","text":"The earth has yielded its increase. God, even our own God, will bless us.","is_omitted":0,"source_line":3357},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":67,"verse_ordinal":961,"verse_start":7,"verse_end":7,"verse_label":"7","text":"God will bless us. All the ends of the earth shall fear him.","is_omitted":0,"source_line":3360}]}