{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":34,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":34,"verse_ordinal":450,"verse_start":1,"verse_end":1,"verse_label":"1","text":"I will bless the LORD at all times. His praise will always be in my mouth.","is_omitted":0,"source_line":1572},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":34,"verse_ordinal":451,"verse_start":2,"verse_end":2,"verse_label":"2","text":"My soul shall boast in the LORD. The humble shall hear of it and be glad.","is_omitted":0,"source_line":1575},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":34,"verse_ordinal":452,"verse_start":3,"verse_end":3,"verse_label":"3","text":"Oh magnify the LORD with me. Let’s exalt his name together.","is_omitted":0,"source_line":1578},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":34,"verse_ordinal":453,"verse_start":4,"verse_end":4,"verse_label":"4","text":"I sought the LORD, and he answered me, and delivered me from all my fears.","is_omitted":0,"source_line":1581},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":34,"verse_ordinal":454,"verse_start":5,"verse_end":5,"verse_label":"5","text":"They looked to him, and were radiant. Their faces shall never be covered with shame.","is_omitted":0,"source_line":1584},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":34,"verse_ordinal":455,"verse_start":6,"verse_end":6,"verse_label":"6","text":"This poor man cried, and the LORD heard him, and saved him out of all his troubles.","is_omitted":0,"source_line":1587},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":34,"verse_ordinal":456,"verse_start":7,"verse_end":7,"verse_label":"7","text":"The LORD’s angel encamps around those who fear him, and delivers them.","is_omitted":0,"source_line":1590},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":34,"verse_ordinal":457,"verse_start":8,"verse_end":8,"verse_label":"8","text":"Oh taste and see that the LORD is good. Blessed is the man who takes refuge in him.","is_omitted":0,"source_line":1593},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":34,"verse_ordinal":458,"verse_start":9,"verse_end":9,"verse_label":"9","text":"Oh fear the LORD, you his saints, for there is no lack with those who fear him.","is_omitted":0,"source_line":1596},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":34,"verse_ordinal":459,"verse_start":10,"verse_end":10,"verse_label":"10","text":"The young lions do lack, and suffer hunger, but those who seek the LORD shall not lack any good thing.","is_omitted":0,"source_line":1599},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":34,"verse_ordinal":460,"verse_start":11,"verse_end":11,"verse_label":"11","text":"Come, you children, listen to me. I will teach you the fear of the LORD.","is_omitted":0,"source_line":1603},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":34,"verse_ordinal":461,"verse_start":12,"verse_end":12,"verse_label":"12","text":"Who is someone who desires life, and loves many days, that he may see good?","is_omitted":0,"source_line":1606},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":34,"verse_ordinal":462,"verse_start":13,"verse_end":13,"verse_label":"13","text":"Keep your tongue from evil, and your lips from speaking lies.","is_omitted":0,"source_line":1609},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":34,"verse_ordinal":463,"verse_start":14,"verse_end":14,"verse_label":"14","text":"Depart from evil, and do good. Seek peace, and pursue it.","is_omitted":0,"source_line":1612},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":34,"verse_ordinal":464,"verse_start":15,"verse_end":15,"verse_label":"15","text":"The LORD’s eyes are toward the righteous. His ears listen to their cry.","is_omitted":0,"source_line":1615},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":34,"verse_ordinal":465,"verse_start":16,"verse_end":16,"verse_label":"16","text":"The LORD’s face is against those who do evil, to cut off their memory from the earth.","is_omitted":0,"source_line":1618},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":34,"verse_ordinal":466,"verse_start":17,"verse_end":17,"verse_label":"17","text":"The righteous cry, and the LORD hears, and delivers them out of all their troubles.","is_omitted":0,"source_line":1621},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":34,"verse_ordinal":467,"verse_start":18,"verse_end":18,"verse_label":"18","text":"The LORD is near to those who have a broken heart, and saves those who have a crushed spirit.","is_omitted":0,"source_line":1624},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":34,"verse_ordinal":468,"verse_start":19,"verse_end":19,"verse_label":"19","text":"Many are the afflictions of the righteous, but the LORD delivers him out of them all.","is_omitted":0,"source_line":1627},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":34,"verse_ordinal":469,"verse_start":20,"verse_end":20,"verse_label":"20","text":"He protects all of his bones. Not one of them is broken.","is_omitted":0,"source_line":1630},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":34,"verse_ordinal":470,"verse_start":21,"verse_end":21,"verse_label":"21","text":"Evil shall kill the wicked. Those who hate the righteous shall be condemned.","is_omitted":0,"source_line":1633},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":34,"verse_ordinal":471,"verse_start":22,"verse_end":22,"verse_label":"22","text":"The LORD redeems the soul of his servants. None of those who take refuge in him shall be condemned.","is_omitted":0,"source_line":1636}]}