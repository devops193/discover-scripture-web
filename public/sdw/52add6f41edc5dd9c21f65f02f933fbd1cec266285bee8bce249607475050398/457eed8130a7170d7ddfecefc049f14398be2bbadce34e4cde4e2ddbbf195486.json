{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:job","chapter":29,"verses":[{"translation_id":"engwebu","book_id":"engwebu:job","chapter":29,"verse_ordinal":664,"verse_start":1,"verse_end":1,"verse_label":"1","text":"Job again took up his parable, and said,","is_omitted":0,"source_line":2110},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":29,"verse_ordinal":665,"verse_start":2,"verse_end":2,"verse_label":"2","text":"“Oh that I were as in the months of old, as in the days when God watched over me;","is_omitted":0,"source_line":2112},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":29,"verse_ordinal":666,"verse_start":3,"verse_end":3,"verse_label":"3","text":"when his lamp shone on my head, and by his light I walked through darkness,","is_omitted":0,"source_line":2115},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":29,"verse_ordinal":667,"verse_start":4,"verse_end":4,"verse_label":"4","text":"as I was in my prime, when the friendship of God was in my tent,","is_omitted":0,"source_line":2118},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":29,"verse_ordinal":668,"verse_start":5,"verse_end":5,"verse_label":"5","text":"when the Almighty was yet with me, and my children were around me,","is_omitted":0,"source_line":2121},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":29,"verse_ordinal":669,"verse_start":6,"verse_end":6,"verse_label":"6","text":"when my steps were washed with butter, and the rock poured out streams of oil for me,","is_omitted":0,"source_line":2124},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":29,"verse_ordinal":670,"verse_start":7,"verse_end":7,"verse_label":"7","text":"when I went out to the city gate, when I prepared my seat in the street.","is_omitted":0,"source_line":2127},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":29,"verse_ordinal":671,"verse_start":8,"verse_end":8,"verse_label":"8","text":"The young men saw me and hid themselves. The aged rose up and stood.","is_omitted":0,"source_line":2130},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":29,"verse_ordinal":672,"verse_start":9,"verse_end":9,"verse_label":"9","text":"The princes refrained from talking, and laid their hand on their mouth.","is_omitted":0,"source_line":2133},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":29,"verse_ordinal":673,"verse_start":10,"verse_end":10,"verse_label":"10","text":"The voice of the nobles was hushed, and their tongue stuck to the roof of their mouth.","is_omitted":0,"source_line":2136},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":29,"verse_ordinal":674,"verse_start":11,"verse_end":11,"verse_label":"11","text":"For when the ear heard me, then it blessed me, and when the eye saw me, it commended me,","is_omitted":0,"source_line":2139},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":29,"verse_ordinal":675,"verse_start":12,"verse_end":12,"verse_label":"12","text":"because I delivered the poor who cried, and the fatherless also, who had no one to help him,","is_omitted":0,"source_line":2142},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":29,"verse_ordinal":676,"verse_start":13,"verse_end":13,"verse_label":"13","text":"the blessing of him who was ready to perish came on me, and I caused the widow’s heart to sing for joy.","is_omitted":0,"source_line":2145},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":29,"verse_ordinal":677,"verse_start":14,"verse_end":14,"verse_label":"14","text":"I put on righteousness, and it clothed me. My justice was as a robe and a diadem.","is_omitted":0,"source_line":2148},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":29,"verse_ordinal":678,"verse_start":15,"verse_end":15,"verse_label":"15","text":"I was eyes to the blind, and feet to the lame.","is_omitted":0,"source_line":2151},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":29,"verse_ordinal":679,"verse_start":16,"verse_end":16,"verse_label":"16","text":"I was a father to the needy. I researched the cause of him whom I didn’t know.","is_omitted":0,"source_line":2154},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":29,"verse_ordinal":680,"verse_start":17,"verse_end":17,"verse_label":"17","text":"I broke the jaws of the unrighteous and plucked the prey out of his teeth.","is_omitted":0,"source_line":2157},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":29,"verse_ordinal":681,"verse_start":18,"verse_end":18,"verse_label":"18","text":"Then I said, ‘I will die in my own house, I will count my days as the sand.","is_omitted":0,"source_line":2160},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":29,"verse_ordinal":682,"verse_start":19,"verse_end":19,"verse_label":"19","text":"My root is spread out to the waters. The dew lies all night on my branch.","is_omitted":0,"source_line":2163},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":29,"verse_ordinal":683,"verse_start":20,"verse_end":20,"verse_label":"20","text":"My glory is fresh in me. My bow is renewed in my hand.’","is_omitted":0,"source_line":2166},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":29,"verse_ordinal":684,"verse_start":21,"verse_end":21,"verse_label":"21","text":"“Men listened to me, waited, and kept silence for my counsel.","is_omitted":0,"source_line":2170},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":29,"verse_ordinal":685,"verse_start":22,"verse_end":22,"verse_label":"22","text":"After my words they didn’t speak again. My speech fell on them.","is_omitted":0,"source_line":2173},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":29,"verse_ordinal":686,"verse_start":23,"verse_end":23,"verse_label":"23","text":"They waited for me as for the rain. Their mouths drank as with the spring rain.","is_omitted":0,"source_line":2176},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":29,"verse_ordinal":687,"verse_start":24,"verse_end":24,"verse_label":"24","text":"I smiled on them when they had no confidence. They didn’t reject the light of my face.","is_omitted":0,"source_line":2179},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":29,"verse_ordinal":688,"verse_start":25,"verse_end":25,"verse_label":"25","text":"I chose out their way, and sat as chief. I lived as a king in the army, as one who comforts the mourners.","is_omitted":0,"source_line":2182}]}