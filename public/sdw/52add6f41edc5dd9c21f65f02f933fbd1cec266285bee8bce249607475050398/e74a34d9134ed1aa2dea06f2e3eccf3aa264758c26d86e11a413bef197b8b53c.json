{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":130,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":130,"verse_ordinal":2202,"verse_start":1,"verse_end":1,"verse_label":"1","text":"Out of the depths I have cried to you, LORD.","is_omitted":0,"source_line":7445},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":130,"verse_ordinal":2203,"verse_start":2,"verse_end":2,"verse_label":"2","text":"Lord, hear my voice. Let your ears be attentive to the voice of my petitions.","is_omitted":0,"source_line":7447},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":130,"verse_ordinal":2204,"verse_start":3,"verse_end":3,"verse_label":"3","text":"If you, LORD, kept a record of sins, Lord, who could stand?","is_omitted":0,"source_line":7450},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":130,"verse_ordinal":2205,"verse_start":4,"verse_end":4,"verse_label":"4","text":"But there is forgiveness with you, therefore you are feared.","is_omitted":0,"source_line":7453},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":130,"verse_ordinal":2206,"verse_start":5,"verse_end":5,"verse_label":"5","text":"I wait for the LORD. My soul waits. I hope in his word.","is_omitted":0,"source_line":7456},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":130,"verse_ordinal":2207,"verse_start":6,"verse_end":6,"verse_label":"6","text":"My soul longs for the Lord more than watchmen long for the morning, more than watchmen for the morning.","is_omitted":0,"source_line":7460},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":130,"verse_ordinal":2208,"verse_start":7,"verse_end":7,"verse_label":"7","text":"Israel, hope in the LORD, for there is loving kindness with the LORD. Abundant redemption is with him.","is_omitted":0,"source_line":7463},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":130,"verse_ordinal":2209,"verse_start":8,"verse_end":8,"verse_label":"8","text":"He will redeem Israel from all their sins.","is_omitted":0,"source_line":7467}]}