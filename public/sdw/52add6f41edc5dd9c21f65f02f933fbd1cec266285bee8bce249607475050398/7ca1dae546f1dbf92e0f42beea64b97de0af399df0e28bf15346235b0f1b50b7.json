{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":148,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":148,"verse_ordinal":2433,"verse_start":1,"verse_end":1,"verse_label":"1","text":"Praise the LORD! Praise the LORD from the heavens! Praise him in the heights!","is_omitted":0,"source_line":8238},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":148,"verse_ordinal":2434,"verse_start":2,"verse_end":2,"verse_label":"2","text":"Praise him, all his angels! Praise him, all his army!","is_omitted":0,"source_line":8242},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":148,"verse_ordinal":2435,"verse_start":3,"verse_end":3,"verse_label":"3","text":"Praise him, sun and moon! Praise him, all you shining stars!","is_omitted":0,"source_line":8245},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":148,"verse_ordinal":2436,"verse_start":4,"verse_end":4,"verse_label":"4","text":"Praise him, you heavens of heavens, you waters that are above the heavens.","is_omitted":0,"source_line":8248},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":148,"verse_ordinal":2437,"verse_start":5,"verse_end":5,"verse_label":"5","text":"Let them praise the LORD’s name, for he commanded, and they were created.","is_omitted":0,"source_line":8251},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":148,"verse_ordinal":2438,"verse_start":6,"verse_end":6,"verse_label":"6","text":"He has also established them forever and ever. He has made a decree which will not pass away.","is_omitted":0,"source_line":8254},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":148,"verse_ordinal":2439,"verse_start":7,"verse_end":7,"verse_label":"7","text":"Praise the LORD from the earth, you great sea creatures, and all depths,","is_omitted":0,"source_line":8257},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":148,"verse_ordinal":2440,"verse_start":8,"verse_end":8,"verse_label":"8","text":"lightning and hail, snow and clouds, stormy wind, fulfilling his word,","is_omitted":0,"source_line":8260},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":148,"verse_ordinal":2441,"verse_start":9,"verse_end":9,"verse_label":"9","text":"mountains and all hills, fruit trees and all cedars,","is_omitted":0,"source_line":8263},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":148,"verse_ordinal":2442,"verse_start":10,"verse_end":10,"verse_label":"10","text":"wild animals and all livestock, small creatures and flying birds,","is_omitted":0,"source_line":8266},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":148,"verse_ordinal":2443,"verse_start":11,"verse_end":11,"verse_label":"11","text":"kings of the earth and all peoples, princes and all judges of the earth,","is_omitted":0,"source_line":8269},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":148,"verse_ordinal":2444,"verse_start":12,"verse_end":12,"verse_label":"12","text":"both young men and maidens, old men and children.","is_omitted":0,"source_line":8272},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":148,"verse_ordinal":2445,"verse_start":13,"verse_end":13,"verse_label":"13","text":"Let them praise the LORD’s name, for his name alone is exalted. His glory is above the earth and the heavens.","is_omitted":0,"source_line":8275},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":148,"verse_ordinal":2446,"verse_start":14,"verse_end":14,"verse_label":"14","text":"He has lifted up the horn of his people, the praise of all his saints, even of the children of Israel, a people near to him. Praise the LORD!","is_omitted":0,"source_line":8279}]}