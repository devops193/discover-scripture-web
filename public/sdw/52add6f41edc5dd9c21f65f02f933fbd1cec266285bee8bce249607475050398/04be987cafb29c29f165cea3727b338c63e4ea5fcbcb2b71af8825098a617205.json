{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":119,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1960,"verse_start":1,"verse_end":1,"verse_label":"1","text":"Blessed are those whose ways are blameless, who walk according to the LORD’s law.","is_omitted":0,"source_line":6670},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1961,"verse_start":2,"verse_end":2,"verse_label":"2","text":"Blessed are those who keep his statutes, who seek him with their whole heart.","is_omitted":0,"source_line":6673},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1962,"verse_start":3,"verse_end":3,"verse_label":"3","text":"Yes, they do nothing wrong. They walk in his ways.","is_omitted":0,"source_line":6676},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1963,"verse_start":4,"verse_end":4,"verse_label":"4","text":"You have commanded your precepts, that we should fully obey them.","is_omitted":0,"source_line":6679},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1964,"verse_start":5,"verse_end":5,"verse_label":"5","text":"Oh that my ways were steadfast to obey your statutes!","is_omitted":0,"source_line":6682},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1965,"verse_start":6,"verse_end":6,"verse_label":"6","text":"Then I wouldn’t be disappointed, when I consider all of your commandments.","is_omitted":0,"source_line":6685},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1966,"verse_start":7,"verse_end":7,"verse_label":"7","text":"I will give thanks to you with uprightness of heart, when I learn your righteous judgments.","is_omitted":0,"source_line":6688},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1967,"verse_start":8,"verse_end":8,"verse_label":"8","text":"I will observe your statutes. Don’t utterly forsake me.","is_omitted":0,"source_line":6691},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1968,"verse_start":9,"verse_end":9,"verse_label":"9","text":"How can a young man keep his way pure? By living according to your word.","is_omitted":0,"source_line":6695},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1969,"verse_start":10,"verse_end":10,"verse_label":"10","text":"With my whole heart I have sought you. Don’t let me wander from your commandments.","is_omitted":0,"source_line":6698},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1970,"verse_start":11,"verse_end":11,"verse_label":"11","text":"I have hidden your word in my heart, that I might not sin against you.","is_omitted":0,"source_line":6701},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1971,"verse_start":12,"verse_end":12,"verse_label":"12","text":"Blessed are you, LORD. Teach me your statutes.","is_omitted":0,"source_line":6704},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1972,"verse_start":13,"verse_end":13,"verse_label":"13","text":"With my lips, I have declared all the ordinances of your mouth.","is_omitted":0,"source_line":6707},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1973,"verse_start":14,"verse_end":14,"verse_label":"14","text":"I have rejoiced in the way of your testimonies, as much as in all riches.","is_omitted":0,"source_line":6710},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1974,"verse_start":15,"verse_end":15,"verse_label":"15","text":"I will meditate on your precepts, and consider your ways.","is_omitted":0,"source_line":6713},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1975,"verse_start":16,"verse_end":16,"verse_label":"16","text":"I will delight myself in your statutes. I will not forget your word.","is_omitted":0,"source_line":6716},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1976,"verse_start":17,"verse_end":17,"verse_label":"17","text":"Do good to your servant. I will live and I will obey your word.","is_omitted":0,"source_line":6720},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1977,"verse_start":18,"verse_end":18,"verse_label":"18","text":"Open my eyes, that I may see wondrous things out of your law.","is_omitted":0,"source_line":6723},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1978,"verse_start":19,"verse_end":19,"verse_label":"19","text":"I am a stranger on the earth. Don’t hide your commandments from me.","is_omitted":0,"source_line":6726},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1979,"verse_start":20,"verse_end":20,"verse_label":"20","text":"My soul is consumed with longing for your ordinances at all times.","is_omitted":0,"source_line":6729},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1980,"verse_start":21,"verse_end":21,"verse_label":"21","text":"You have rebuked the proud who are cursed, who wander from your commandments.","is_omitted":0,"source_line":6731},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1981,"verse_start":22,"verse_end":22,"verse_label":"22","text":"Take reproach and contempt away from me, for I have kept your statutes.","is_omitted":0,"source_line":6734},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1982,"verse_start":23,"verse_end":23,"verse_label":"23","text":"Though princes sit and slander me, your servant will meditate on your statutes.","is_omitted":0,"source_line":6737},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1983,"verse_start":24,"verse_end":24,"verse_label":"24","text":"Indeed your statutes are my delight, and my counselors.","is_omitted":0,"source_line":6740},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1984,"verse_start":25,"verse_end":25,"verse_label":"25","text":"My soul is laid low in the dust. Revive me according to your word!","is_omitted":0,"source_line":6744},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1985,"verse_start":26,"verse_end":26,"verse_label":"26","text":"I declared my ways, and you answered me. Teach me your statutes.","is_omitted":0,"source_line":6747},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1986,"verse_start":27,"verse_end":27,"verse_label":"27","text":"Let me understand the teaching of your precepts! Then I will meditate on your wondrous works.","is_omitted":0,"source_line":6750},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1987,"verse_start":28,"verse_end":28,"verse_label":"28","text":"My soul is weary with sorrow; strengthen me according to your word.","is_omitted":0,"source_line":6753},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1988,"verse_start":29,"verse_end":29,"verse_label":"29","text":"Keep me from the way of deceit. Grant me your law graciously!","is_omitted":0,"source_line":6756},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1989,"verse_start":30,"verse_end":30,"verse_label":"30","text":"I have chosen the way of truth. I have set your ordinances before me.","is_omitted":0,"source_line":6759},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1990,"verse_start":31,"verse_end":31,"verse_label":"31","text":"I cling to your statutes, LORD. Don’t let me be disappointed.","is_omitted":0,"source_line":6762},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1991,"verse_start":32,"verse_end":32,"verse_label":"32","text":"I run in the path of your commandments, for you have set my heart free.","is_omitted":0,"source_line":6765},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1992,"verse_start":33,"verse_end":33,"verse_label":"33","text":"Teach me, LORD, the way of your statutes. I will keep them to the end.","is_omitted":0,"source_line":6769},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1993,"verse_start":34,"verse_end":34,"verse_label":"34","text":"Give me understanding, and I will keep your law. Yes, I will obey it with my whole heart.","is_omitted":0,"source_line":6772},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1994,"verse_start":35,"verse_end":35,"verse_label":"35","text":"Direct me in the path of your commandments, for I delight in them.","is_omitted":0,"source_line":6775},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1995,"verse_start":36,"verse_end":36,"verse_label":"36","text":"Turn my heart toward your statutes, not toward selfish gain.","is_omitted":0,"source_line":6778},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1996,"verse_start":37,"verse_end":37,"verse_label":"37","text":"Turn my eyes away from looking at worthless things. Revive me in your ways.","is_omitted":0,"source_line":6781},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1997,"verse_start":38,"verse_end":38,"verse_label":"38","text":"Fulfill your promise to your servant, that you may be feared.","is_omitted":0,"source_line":6784},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1998,"verse_start":39,"verse_end":39,"verse_label":"39","text":"Take away my disgrace that I dread, for your ordinances are good.","is_omitted":0,"source_line":6787},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":1999,"verse_start":40,"verse_end":40,"verse_label":"40","text":"Behold, I long for your precepts! Revive me in your righteousness.","is_omitted":0,"source_line":6790},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2000,"verse_start":41,"verse_end":41,"verse_label":"41","text":"Let your loving kindness also come to me, LORD, your salvation, according to your word.","is_omitted":0,"source_line":6794},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2001,"verse_start":42,"verse_end":42,"verse_label":"42","text":"So I will have an answer for him who reproaches me, for I trust in your word.","is_omitted":0,"source_line":6797},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2002,"verse_start":43,"verse_end":43,"verse_label":"43","text":"Don’t snatch the word of truth out of my mouth, for I put my hope in your ordinances.","is_omitted":0,"source_line":6800},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2003,"verse_start":44,"verse_end":44,"verse_label":"44","text":"So I will obey your law continually, forever and ever.","is_omitted":0,"source_line":6803},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2004,"verse_start":45,"verse_end":45,"verse_label":"45","text":"I will walk in liberty, for I have sought your precepts.","is_omitted":0,"source_line":6806},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2005,"verse_start":46,"verse_end":46,"verse_label":"46","text":"I will also speak of your statutes before kings, and will not be disappointed.","is_omitted":0,"source_line":6809},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2006,"verse_start":47,"verse_end":47,"verse_label":"47","text":"I will delight myself in your commandments, because I love them.","is_omitted":0,"source_line":6812},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2007,"verse_start":48,"verse_end":48,"verse_label":"48","text":"I reach out my hands for your commandments, which I love. I will meditate on your statutes.","is_omitted":0,"source_line":6815},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2008,"verse_start":49,"verse_end":49,"verse_label":"49","text":"Remember your word to your servant, because you gave me hope.","is_omitted":0,"source_line":6819},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2009,"verse_start":50,"verse_end":50,"verse_label":"50","text":"This is my comfort in my affliction, for your word has revived me.","is_omitted":0,"source_line":6822},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2010,"verse_start":51,"verse_end":51,"verse_label":"51","text":"The arrogant mock me excessively, but I don’t swerve from your law.","is_omitted":0,"source_line":6825},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2011,"verse_start":52,"verse_end":52,"verse_label":"52","text":"I remember your ordinances of old, LORD, and have comforted myself.","is_omitted":0,"source_line":6828},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2012,"verse_start":53,"verse_end":53,"verse_label":"53","text":"Indignation has taken hold on me, because of the wicked who forsake your law.","is_omitted":0,"source_line":6831},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2013,"verse_start":54,"verse_end":54,"verse_label":"54","text":"Your statutes have been my songs in the house where I live.","is_omitted":0,"source_line":6834},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2014,"verse_start":55,"verse_end":55,"verse_label":"55","text":"I have remembered your name, LORD, in the night, and I obey your law.","is_omitted":0,"source_line":6837},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2015,"verse_start":56,"verse_end":56,"verse_label":"56","text":"This is my way, that I keep your precepts.","is_omitted":0,"source_line":6840},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2016,"verse_start":57,"verse_end":57,"verse_label":"57","text":"The LORD is my portion. I promised to obey your words.","is_omitted":0,"source_line":6844},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2017,"verse_start":58,"verse_end":58,"verse_label":"58","text":"I sought your favor with my whole heart. Be merciful to me according to your word.","is_omitted":0,"source_line":6847},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2018,"verse_start":59,"verse_end":59,"verse_label":"59","text":"I considered my ways, and turned my steps to your statutes.","is_omitted":0,"source_line":6850},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2019,"verse_start":60,"verse_end":60,"verse_label":"60","text":"I will hurry, and not delay, to obey your commandments.","is_omitted":0,"source_line":6853},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2020,"verse_start":61,"verse_end":61,"verse_label":"61","text":"The ropes of the wicked bind me, but I won’t forget your law.","is_omitted":0,"source_line":6856},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2021,"verse_start":62,"verse_end":62,"verse_label":"62","text":"At midnight I will rise to give thanks to you, because of your righteous ordinances.","is_omitted":0,"source_line":6859},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2022,"verse_start":63,"verse_end":63,"verse_label":"63","text":"I am a friend of all those who fear you, of those who observe your precepts.","is_omitted":0,"source_line":6862},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2023,"verse_start":64,"verse_end":64,"verse_label":"64","text":"The earth is full of your loving kindness, LORD. Teach me your statutes.","is_omitted":0,"source_line":6865},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2024,"verse_start":65,"verse_end":65,"verse_label":"65","text":"You have treated your servant well, according to your word, LORD.","is_omitted":0,"source_line":6869},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2025,"verse_start":66,"verse_end":66,"verse_label":"66","text":"Teach me good judgment and knowledge, for I believe in your commandments.","is_omitted":0,"source_line":6872},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2026,"verse_start":67,"verse_end":67,"verse_label":"67","text":"Before I was afflicted, I went astray; but now I observe your word.","is_omitted":0,"source_line":6875},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2027,"verse_start":68,"verse_end":68,"verse_label":"68","text":"You are good, and do good. Teach me your statutes.","is_omitted":0,"source_line":6878},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2028,"verse_start":69,"verse_end":69,"verse_label":"69","text":"The proud have smeared a lie upon me. With my whole heart, I will keep your precepts.","is_omitted":0,"source_line":6881},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2029,"verse_start":70,"verse_end":70,"verse_label":"70","text":"Their heart is as callous as the fat, but I delight in your law.","is_omitted":0,"source_line":6884},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2030,"verse_start":71,"verse_end":71,"verse_label":"71","text":"It is good for me that I have been afflicted, that I may learn your statutes.","is_omitted":0,"source_line":6887},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2031,"verse_start":72,"verse_end":72,"verse_label":"72","text":"The law of your mouth is better to me than thousands of pieces of gold and silver.","is_omitted":0,"source_line":6890},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2032,"verse_start":73,"verse_end":73,"verse_label":"73","text":"Your hands have made me and formed me. Give me understanding, that I may learn your commandments.","is_omitted":0,"source_line":6893},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2033,"verse_start":74,"verse_end":74,"verse_label":"74","text":"Those who fear you will see me and be glad, because I have put my hope in your word.","is_omitted":0,"source_line":6896},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2034,"verse_start":75,"verse_end":75,"verse_label":"75","text":"LORD, I know that your judgments are righteous, that in faithfulness you have afflicted me.","is_omitted":0,"source_line":6899},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2035,"verse_start":76,"verse_end":76,"verse_label":"76","text":"Please let your loving kindness be for my comfort, according to your word to your servant.","is_omitted":0,"source_line":6902},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2036,"verse_start":77,"verse_end":77,"verse_label":"77","text":"Let your tender mercies come to me, that I may live; for your law is my delight.","is_omitted":0,"source_line":6905},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2037,"verse_start":78,"verse_end":78,"verse_label":"78","text":"Let the proud be disappointed, for they have overthrown me wrongfully. I will meditate on your precepts.","is_omitted":0,"source_line":6908},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2038,"verse_start":79,"verse_end":79,"verse_label":"79","text":"Let those who fear you turn to me. They will know your statutes.","is_omitted":0,"source_line":6911},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2039,"verse_start":80,"verse_end":80,"verse_label":"80","text":"Let my heart be blameless toward your decrees, that I may not be disappointed.","is_omitted":0,"source_line":6914},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2040,"verse_start":81,"verse_end":81,"verse_label":"81","text":"My soul faints for your salvation. I hope in your word.","is_omitted":0,"source_line":6918},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2041,"verse_start":82,"verse_end":82,"verse_label":"82","text":"My eyes fail for your word. I say, “When will you comfort me?”","is_omitted":0,"source_line":6921},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2042,"verse_start":83,"verse_end":83,"verse_label":"83","text":"For I have become like a wineskin in the smoke. I don’t forget your statutes.","is_omitted":0,"source_line":6924},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2043,"verse_start":84,"verse_end":84,"verse_label":"84","text":"How many are the days of your servant? When will you execute judgment on those who persecute me?","is_omitted":0,"source_line":6927},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2044,"verse_start":85,"verse_end":85,"verse_label":"85","text":"The proud have dug pits for me, contrary to your law.","is_omitted":0,"source_line":6930},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2045,"verse_start":86,"verse_end":86,"verse_label":"86","text":"All of your commandments are faithful. They persecute me wrongfully. Help me!","is_omitted":0,"source_line":6933},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2046,"verse_start":87,"verse_end":87,"verse_label":"87","text":"They had almost wiped me from the earth, but I didn’t forsake your precepts.","is_omitted":0,"source_line":6937},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2047,"verse_start":88,"verse_end":88,"verse_label":"88","text":"Preserve my life according to your loving kindness, so I will obey the statutes of your mouth.","is_omitted":0,"source_line":6940},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2048,"verse_start":89,"verse_end":89,"verse_label":"89","text":"LORD, your word is settled in heaven forever.","is_omitted":0,"source_line":6944},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2049,"verse_start":90,"verse_end":90,"verse_label":"90","text":"Your faithfulness is to all generations. You have established the earth, and it remains.","is_omitted":0,"source_line":6946},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2050,"verse_start":91,"verse_end":91,"verse_label":"91","text":"Your laws remain to this day, for all things serve you.","is_omitted":0,"source_line":6949},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2051,"verse_start":92,"verse_end":92,"verse_label":"92","text":"Unless your law had been my delight, I would have perished in my affliction.","is_omitted":0,"source_line":6952},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2052,"verse_start":93,"verse_end":93,"verse_label":"93","text":"I will never forget your precepts, for with them, you have revived me.","is_omitted":0,"source_line":6955},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2053,"verse_start":94,"verse_end":94,"verse_label":"94","text":"I am yours. Save me, for I have sought your precepts.","is_omitted":0,"source_line":6958},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2054,"verse_start":95,"verse_end":95,"verse_label":"95","text":"The wicked have waited for me, to destroy me. I will consider your statutes.","is_omitted":0,"source_line":6961},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2055,"verse_start":96,"verse_end":96,"verse_label":"96","text":"I have seen a limit to all perfection, but your commands are boundless.","is_omitted":0,"source_line":6964},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2056,"verse_start":97,"verse_end":97,"verse_label":"97","text":"How I love your law! It is my meditation all day.","is_omitted":0,"source_line":6968},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2057,"verse_start":98,"verse_end":98,"verse_label":"98","text":"Your commandments make me wiser than my enemies, for your commandments are always with me.","is_omitted":0,"source_line":6971},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2058,"verse_start":99,"verse_end":99,"verse_label":"99","text":"I have more understanding than all my teachers, for your testimonies are my meditation.","is_omitted":0,"source_line":6974},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2059,"verse_start":100,"verse_end":100,"verse_label":"100","text":"I understand more than the aged, because I have kept your precepts.","is_omitted":0,"source_line":6977},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2060,"verse_start":101,"verse_end":101,"verse_label":"101","text":"I have kept my feet from every evil way, that I might observe your word.","is_omitted":0,"source_line":6980},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2061,"verse_start":102,"verse_end":102,"verse_label":"102","text":"I have not turned away from your ordinances, for you have taught me.","is_omitted":0,"source_line":6983},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2062,"verse_start":103,"verse_end":103,"verse_label":"103","text":"How sweet are your promises to my taste, more than honey to my mouth!","is_omitted":0,"source_line":6986},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2063,"verse_start":104,"verse_end":104,"verse_label":"104","text":"Through your precepts, I get understanding; therefore I hate every false way.","is_omitted":0,"source_line":6989},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2064,"verse_start":105,"verse_end":105,"verse_label":"105","text":"Your word is a lamp to my feet, and a light for my path.","is_omitted":0,"source_line":6993},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2065,"verse_start":106,"verse_end":106,"verse_label":"106","text":"I have sworn, and have confirmed it, that I will obey your righteous ordinances.","is_omitted":0,"source_line":6996},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2066,"verse_start":107,"verse_end":107,"verse_label":"107","text":"I am afflicted very much. Revive me, LORD, according to your word.","is_omitted":0,"source_line":6999},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2067,"verse_start":108,"verse_end":108,"verse_label":"108","text":"Accept, I beg you, the willing offerings of my mouth. LORD, teach me your ordinances.","is_omitted":0,"source_line":7002},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2068,"verse_start":109,"verse_end":109,"verse_label":"109","text":"My soul is continually in my hand, yet I won’t forget your law.","is_omitted":0,"source_line":7005},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2069,"verse_start":110,"verse_end":110,"verse_label":"110","text":"The wicked have laid a snare for me, yet I haven’t gone astray from your precepts.","is_omitted":0,"source_line":7008},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2070,"verse_start":111,"verse_end":111,"verse_label":"111","text":"I have taken your testimonies as a heritage forever, for they are the joy of my heart.","is_omitted":0,"source_line":7011},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2071,"verse_start":112,"verse_end":112,"verse_label":"112","text":"I have set my heart to perform your statutes forever, even to the end.","is_omitted":0,"source_line":7014},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2072,"verse_start":113,"verse_end":113,"verse_label":"113","text":"I hate double-minded men, but I love your law.","is_omitted":0,"source_line":7018},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2073,"verse_start":114,"verse_end":114,"verse_label":"114","text":"You are my hiding place and my shield. I hope in your word.","is_omitted":0,"source_line":7021},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2074,"verse_start":115,"verse_end":115,"verse_label":"115","text":"Depart from me, you evildoers, that I may keep the commandments of my God.","is_omitted":0,"source_line":7024},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2075,"verse_start":116,"verse_end":116,"verse_label":"116","text":"Uphold me according to your word, that I may live. Let me not be ashamed of my hope.","is_omitted":0,"source_line":7027},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2076,"verse_start":117,"verse_end":117,"verse_label":"117","text":"Hold me up, and I will be safe, and will have respect for your statutes continually.","is_omitted":0,"source_line":7030},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2077,"verse_start":118,"verse_end":118,"verse_label":"118","text":"You reject all those who stray from your statutes, for their deceit is in vain.","is_omitted":0,"source_line":7033},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2078,"verse_start":119,"verse_end":119,"verse_label":"119","text":"You put away all the wicked of the earth like dross. Therefore I love your testimonies.","is_omitted":0,"source_line":7036},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2079,"verse_start":120,"verse_end":120,"verse_label":"120","text":"My flesh trembles for fear of you. I am afraid of your judgments.","is_omitted":0,"source_line":7039},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2080,"verse_start":121,"verse_end":121,"verse_label":"121","text":"I have done what is just and righteous. Don’t leave me to my oppressors.","is_omitted":0,"source_line":7043},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2081,"verse_start":122,"verse_end":122,"verse_label":"122","text":"Ensure your servant’s well-being. Don’t let the proud oppress me.","is_omitted":0,"source_line":7046},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2082,"verse_start":123,"verse_end":123,"verse_label":"123","text":"My eyes fail looking for your salvation, for your righteous word.","is_omitted":0,"source_line":7049},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2083,"verse_start":124,"verse_end":124,"verse_label":"124","text":"Deal with your servant according to your loving kindness. Teach me your statutes.","is_omitted":0,"source_line":7052},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2084,"verse_start":125,"verse_end":125,"verse_label":"125","text":"I am your servant. Give me understanding, that I may know your testimonies.","is_omitted":0,"source_line":7055},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2085,"verse_start":126,"verse_end":126,"verse_label":"126","text":"It is time to act, LORD, for they break your law.","is_omitted":0,"source_line":7058},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2086,"verse_start":127,"verse_end":127,"verse_label":"127","text":"Therefore I love your commandments more than gold, yes, more than pure gold.","is_omitted":0,"source_line":7061},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2087,"verse_start":128,"verse_end":128,"verse_label":"128","text":"Therefore I consider all of your precepts to be right. I hate every false way.","is_omitted":0,"source_line":7064},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2088,"verse_start":129,"verse_end":129,"verse_label":"129","text":"Your testimonies are wonderful, therefore my soul keeps them.","is_omitted":0,"source_line":7068},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2089,"verse_start":130,"verse_end":130,"verse_label":"130","text":"The entrance of your words gives light. It gives understanding to the simple.","is_omitted":0,"source_line":7071},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2090,"verse_start":131,"verse_end":131,"verse_label":"131","text":"I opened my mouth wide and panted, for I longed for your commandments.","is_omitted":0,"source_line":7074},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2091,"verse_start":132,"verse_end":132,"verse_label":"132","text":"Turn to me, and have mercy on me, as you always do to those who love your name.","is_omitted":0,"source_line":7077},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2092,"verse_start":133,"verse_end":133,"verse_label":"133","text":"Establish my footsteps in your word. Don’t let any iniquity have dominion over me.","is_omitted":0,"source_line":7080},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2093,"verse_start":134,"verse_end":134,"verse_label":"134","text":"Redeem me from the oppression of man, so I will observe your precepts.","is_omitted":0,"source_line":7083},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2094,"verse_start":135,"verse_end":135,"verse_label":"135","text":"Make your face shine on your servant. Teach me your statutes.","is_omitted":0,"source_line":7086},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2095,"verse_start":136,"verse_end":136,"verse_label":"136","text":"Streams of tears run down my eyes, because they don’t observe your law.","is_omitted":0,"source_line":7089},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2096,"verse_start":137,"verse_end":137,"verse_label":"137","text":"You are righteous, LORD. Your judgments are upright.","is_omitted":0,"source_line":7093},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2097,"verse_start":138,"verse_end":138,"verse_label":"138","text":"You have commanded your statutes in righteousness. They are fully trustworthy.","is_omitted":0,"source_line":7096},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2098,"verse_start":139,"verse_end":139,"verse_label":"139","text":"My zeal wears me out, because my enemies ignore your words.","is_omitted":0,"source_line":7099},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2099,"verse_start":140,"verse_end":140,"verse_label":"140","text":"Your promises have been thoroughly tested, and your servant loves them.","is_omitted":0,"source_line":7102},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2100,"verse_start":141,"verse_end":141,"verse_label":"141","text":"I am small and despised. I don’t forget your precepts.","is_omitted":0,"source_line":7105},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2101,"verse_start":142,"verse_end":142,"verse_label":"142","text":"Your righteousness is an everlasting righteousness. Your law is truth.","is_omitted":0,"source_line":7108},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2102,"verse_start":143,"verse_end":143,"verse_label":"143","text":"Trouble and anguish have taken hold of me. Your commandments are my delight.","is_omitted":0,"source_line":7111},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2103,"verse_start":144,"verse_end":144,"verse_label":"144","text":"Your testimonies are righteous forever. Give me understanding, that I may live.","is_omitted":0,"source_line":7114},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2104,"verse_start":145,"verse_end":145,"verse_label":"145","text":"I have called with my whole heart. Answer me, LORD! I will keep your statutes.","is_omitted":0,"source_line":7118},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2105,"verse_start":146,"verse_end":146,"verse_label":"146","text":"I have called to you. Save me! I will obey your statutes.","is_omitted":0,"source_line":7122},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2106,"verse_start":147,"verse_end":147,"verse_label":"147","text":"I rise before dawn and cry for help. I put my hope in your words.","is_omitted":0,"source_line":7125},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2107,"verse_start":148,"verse_end":148,"verse_label":"148","text":"My eyes stay open through the night watches, that I might meditate on your word.","is_omitted":0,"source_line":7128},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2108,"verse_start":149,"verse_end":149,"verse_label":"149","text":"Hear my voice according to your loving kindness. Revive me, LORD, according to your ordinances.","is_omitted":0,"source_line":7131},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2109,"verse_start":150,"verse_end":150,"verse_label":"150","text":"They draw near who follow after wickedness. They are far from your law.","is_omitted":0,"source_line":7134},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2110,"verse_start":151,"verse_end":151,"verse_label":"151","text":"You are near, LORD. All your commandments are truth.","is_omitted":0,"source_line":7137},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2111,"verse_start":152,"verse_end":152,"verse_label":"152","text":"Of old I have known from your testimonies, that you have founded them forever.","is_omitted":0,"source_line":7140},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2112,"verse_start":153,"verse_end":153,"verse_label":"153","text":"Consider my affliction, and deliver me, for I don’t forget your law.","is_omitted":0,"source_line":7144},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2113,"verse_start":154,"verse_end":154,"verse_label":"154","text":"Plead my cause, and redeem me! Revive me according to your promise.","is_omitted":0,"source_line":7147},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2114,"verse_start":155,"verse_end":155,"verse_label":"155","text":"Salvation is far from the wicked, for they don’t seek your statutes.","is_omitted":0,"source_line":7150},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2115,"verse_start":156,"verse_end":156,"verse_label":"156","text":"Great are your tender mercies, LORD. Revive me according to your ordinances.","is_omitted":0,"source_line":7153},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2116,"verse_start":157,"verse_end":157,"verse_label":"157","text":"Many are my persecutors and my adversaries. I haven’t swerved from your testimonies.","is_omitted":0,"source_line":7156},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2117,"verse_start":158,"verse_end":158,"verse_label":"158","text":"I look at the faithless with loathing, because they don’t observe your word.","is_omitted":0,"source_line":7159},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2118,"verse_start":159,"verse_end":159,"verse_label":"159","text":"Consider how I love your precepts. Revive me, LORD, according to your loving kindness.","is_omitted":0,"source_line":7162},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2119,"verse_start":160,"verse_end":160,"verse_label":"160","text":"All of your words are truth. Every one of your righteous ordinances endures forever.","is_omitted":0,"source_line":7165},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2120,"verse_start":161,"verse_end":161,"verse_label":"161","text":"Princes have persecuted me without a cause, but my heart stands in awe of your words.","is_omitted":0,"source_line":7169},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2121,"verse_start":162,"verse_end":162,"verse_label":"162","text":"I rejoice at your word, as one who finds great plunder.","is_omitted":0,"source_line":7172},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2122,"verse_start":163,"verse_end":163,"verse_label":"163","text":"I hate and abhor falsehood. I love your law.","is_omitted":0,"source_line":7175},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2123,"verse_start":164,"verse_end":164,"verse_label":"164","text":"Seven times a day, I praise you, because of your righteous ordinances.","is_omitted":0,"source_line":7178},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2124,"verse_start":165,"verse_end":165,"verse_label":"165","text":"Those who love your law have great peace. Nothing causes them to stumble.","is_omitted":0,"source_line":7181},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2125,"verse_start":166,"verse_end":166,"verse_label":"166","text":"I have hoped for your salvation, LORD. I have done your commandments.","is_omitted":0,"source_line":7184},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2126,"verse_start":167,"verse_end":167,"verse_label":"167","text":"My soul has observed your testimonies. I love them exceedingly.","is_omitted":0,"source_line":7187},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2127,"verse_start":168,"verse_end":168,"verse_label":"168","text":"I have obeyed your precepts and your testimonies, for all my ways are before you.","is_omitted":0,"source_line":7190},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2128,"verse_start":169,"verse_end":169,"verse_label":"169","text":"Let my cry come before you, LORD. Give me understanding according to your word.","is_omitted":0,"source_line":7194},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2129,"verse_start":170,"verse_end":170,"verse_label":"170","text":"Let my supplication come before you. Deliver me according to your word.","is_omitted":0,"source_line":7197},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2130,"verse_start":171,"verse_end":171,"verse_label":"171","text":"Let my lips utter praise, for you teach me your statutes.","is_omitted":0,"source_line":7200},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2131,"verse_start":172,"verse_end":172,"verse_label":"172","text":"Let my tongue sing of your word, for all your commandments are righteousness.","is_omitted":0,"source_line":7203},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2132,"verse_start":173,"verse_end":173,"verse_label":"173","text":"Let your hand be ready to help me, for I have chosen your precepts.","is_omitted":0,"source_line":7206},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2133,"verse_start":174,"verse_end":174,"verse_label":"174","text":"I have longed for your salvation, LORD. Your law is my delight.","is_omitted":0,"source_line":7209},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2134,"verse_start":175,"verse_end":175,"verse_label":"175","text":"Let my soul live, that I may praise you. Let your ordinances help me.","is_omitted":0,"source_line":7212},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":119,"verse_ordinal":2135,"verse_start":176,"verse_end":176,"verse_label":"176","text":"I have gone astray like a lost sheep. Seek your servant, for I don’t forget your commandments.","is_omitted":0,"source_line":7215}]}