{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":115,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":115,"verse_ordinal":1892,"verse_start":1,"verse_end":1,"verse_label":"1","text":"Not to us, LORD, not to us, but to your name give glory, for your loving kindness, and for your truth’s sake.","is_omitted":0,"source_line":6454},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":115,"verse_ordinal":1893,"verse_start":2,"verse_end":2,"verse_label":"2","text":"Why should the nations say, “Where is their God, now?”","is_omitted":0,"source_line":6458},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":115,"verse_ordinal":1894,"verse_start":3,"verse_end":3,"verse_label":"3","text":"But our God is in the heavens. He does whatever he pleases.","is_omitted":0,"source_line":6461},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":115,"verse_ordinal":1895,"verse_start":4,"verse_end":4,"verse_label":"4","text":"Their idols are silver and gold, the work of men’s hands.","is_omitted":0,"source_line":6464},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":115,"verse_ordinal":1896,"verse_start":5,"verse_end":5,"verse_label":"5","text":"They have mouths, but they don’t speak. They have eyes, but they don’t see.","is_omitted":0,"source_line":6467},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":115,"verse_ordinal":1897,"verse_start":6,"verse_end":6,"verse_label":"6","text":"They have ears, but they don’t hear. They have noses, but they don’t smell.","is_omitted":0,"source_line":6470},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":115,"verse_ordinal":1898,"verse_start":7,"verse_end":7,"verse_label":"7","text":"They have hands, but they don’t feel. They have feet, but they don’t walk, neither do they speak through their throat.","is_omitted":0,"source_line":6473},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":115,"verse_ordinal":1899,"verse_start":8,"verse_end":8,"verse_label":"8","text":"Those who make them will be like them; yes, everyone who trusts in them.","is_omitted":0,"source_line":6477},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":115,"verse_ordinal":1900,"verse_start":9,"verse_end":9,"verse_label":"9","text":"Israel, trust in the LORD! He is their help and their shield.","is_omitted":0,"source_line":6480},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":115,"verse_ordinal":1901,"verse_start":10,"verse_end":10,"verse_label":"10","text":"House of Aaron, trust in the LORD! He is their help and their shield.","is_omitted":0,"source_line":6483},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":115,"verse_ordinal":1902,"verse_start":11,"verse_end":11,"verse_label":"11","text":"You who fear the LORD, trust in the LORD! He is their help and their shield.","is_omitted":0,"source_line":6486},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":115,"verse_ordinal":1903,"verse_start":12,"verse_end":12,"verse_label":"12","text":"The LORD remembers us. He will bless us. He will bless the house of Israel. He will bless the house of Aaron.","is_omitted":0,"source_line":6489},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":115,"verse_ordinal":1904,"verse_start":13,"verse_end":13,"verse_label":"13","text":"He will bless those who fear the LORD, both small and great.","is_omitted":0,"source_line":6493},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":115,"verse_ordinal":1905,"verse_start":14,"verse_end":14,"verse_label":"14","text":"May the LORD increase you more and more, you and your children.","is_omitted":0,"source_line":6496},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":115,"verse_ordinal":1906,"verse_start":15,"verse_end":15,"verse_label":"15","text":"Blessed are you by the LORD, who made heaven and earth.","is_omitted":0,"source_line":6499},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":115,"verse_ordinal":1907,"verse_start":16,"verse_end":16,"verse_label":"16","text":"The heavens are the LORD’s heavens, but he has given the earth to the children of men.","is_omitted":0,"source_line":6502},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":115,"verse_ordinal":1908,"verse_start":17,"verse_end":17,"verse_label":"17","text":"The dead don’t praise the LORD, nor any who go down into silence,","is_omitted":0,"source_line":6505},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":115,"verse_ordinal":1909,"verse_start":18,"verse_end":18,"verse_label":"18","text":"but we will bless the LORD, from this time forward and forever more. Praise the LORD!","is_omitted":0,"source_line":6508}]}