{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":6,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":6,"verse_ordinal":47,"verse_start":1,"verse_end":1,"verse_label":"1","text":"LORD, don’t rebuke me in your anger, neither discipline me in your wrath.","is_omitted":0,"source_line":172},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":6,"verse_ordinal":48,"verse_start":2,"verse_end":2,"verse_label":"2","text":"Have mercy on me, LORD, for I am faint. LORD, heal me, for my bones are troubled.","is_omitted":0,"source_line":175},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":6,"verse_ordinal":49,"verse_start":3,"verse_end":3,"verse_label":"3","text":"My soul is also in great anguish. But you, LORD—how long?","is_omitted":0,"source_line":178},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":6,"verse_ordinal":50,"verse_start":4,"verse_end":4,"verse_label":"4","text":"Return, LORD. Deliver my soul, and save me for your loving kindness’ sake.","is_omitted":0,"source_line":181},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":6,"verse_ordinal":51,"verse_start":5,"verse_end":5,"verse_label":"5","text":"For in death there is no memory of you. In Sheol, who shall give you thanks?","is_omitted":0,"source_line":184},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":6,"verse_ordinal":52,"verse_start":6,"verse_end":6,"verse_label":"6","text":"I am weary with my groaning. Every night I flood my bed. I drench my couch with my tears.","is_omitted":0,"source_line":187},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":6,"verse_ordinal":53,"verse_start":7,"verse_end":7,"verse_label":"7","text":"My eye wastes away because of grief. It grows old because of all my adversaries.","is_omitted":0,"source_line":191},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":6,"verse_ordinal":54,"verse_start":8,"verse_end":8,"verse_label":"8","text":"Depart from me, all you workers of iniquity, for the LORD has heard the voice of my weeping.","is_omitted":0,"source_line":194},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":6,"verse_ordinal":55,"verse_start":9,"verse_end":9,"verse_label":"9","text":"The LORD has heard my supplication. The LORD accepts my prayer.","is_omitted":0,"source_line":197},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":6,"verse_ordinal":56,"verse_start":10,"verse_end":10,"verse_label":"10","text":"May all my enemies be ashamed and dismayed. They shall turn back, they shall be disgraced suddenly.","is_omitted":0,"source_line":200}]}