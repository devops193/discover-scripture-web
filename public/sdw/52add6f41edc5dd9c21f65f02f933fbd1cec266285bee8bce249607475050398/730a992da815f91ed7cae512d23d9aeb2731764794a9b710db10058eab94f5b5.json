{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":61,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":61,"verse_ordinal":881,"verse_start":1,"verse_end":1,"verse_label":"1","text":"Hear my cry, God. Listen to my prayer.","is_omitted":0,"source_line":3078},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":61,"verse_ordinal":882,"verse_start":2,"verse_end":2,"verse_label":"2","text":"From the end of the earth, I will call to you when my heart is overwhelmed. Lead me to the rock that is higher than I.","is_omitted":0,"source_line":3081},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":61,"verse_ordinal":883,"verse_start":3,"verse_end":3,"verse_label":"3","text":"For you have been a refuge for me, a strong tower from the enemy.","is_omitted":0,"source_line":3084},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":61,"verse_ordinal":884,"verse_start":4,"verse_end":4,"verse_label":"4","text":"I will dwell in your tent forever. I will take refuge in the shelter of your wings. Selah.","is_omitted":0,"source_line":3087},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":61,"verse_ordinal":885,"verse_start":5,"verse_end":5,"verse_label":"5","text":"For you, God, have heard my vows. You have given me the heritage of those who fear your name.","is_omitted":0,"source_line":3090},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":61,"verse_ordinal":886,"verse_start":6,"verse_end":6,"verse_label":"6","text":"You will prolong the king’s life. His years will be for generations.","is_omitted":0,"source_line":3093},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":61,"verse_ordinal":887,"verse_start":7,"verse_end":7,"verse_label":"7","text":"He shall be enthroned in God’s presence forever. Appoint your loving kindness and truth, that they may preserve him.","is_omitted":0,"source_line":3096},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":61,"verse_ordinal":888,"verse_start":8,"verse_end":8,"verse_label":"8","text":"So I will sing praise to your name forever, that I may fulfill my vows daily.","is_omitted":0,"source_line":3099}]}