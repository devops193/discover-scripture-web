{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":124,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":124,"verse_ordinal":2164,"verse_start":1,"verse_end":1,"verse_label":"1","text":"If it had not been the LORD who was on our side, let Israel now say,","is_omitted":0,"source_line":7314},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":124,"verse_ordinal":2165,"verse_start":2,"verse_end":2,"verse_label":"2","text":"if it had not been the LORD who was on our side, when men rose up against us,","is_omitted":0,"source_line":7317},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":124,"verse_ordinal":2166,"verse_start":3,"verse_end":3,"verse_label":"3","text":"then they would have swallowed us up alive, when their wrath was kindled against us,","is_omitted":0,"source_line":7320},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":124,"verse_ordinal":2167,"verse_start":4,"verse_end":4,"verse_label":"4","text":"then the waters would have overwhelmed us, the stream would have gone over our soul.","is_omitted":0,"source_line":7323},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":124,"verse_ordinal":2168,"verse_start":5,"verse_end":5,"verse_label":"5","text":"Then the proud waters would have gone over our soul.","is_omitted":0,"source_line":7326},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":124,"verse_ordinal":2169,"verse_start":6,"verse_end":6,"verse_label":"6","text":"Blessed be the LORD, who has not given us as a prey to their teeth.","is_omitted":0,"source_line":7328},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":124,"verse_ordinal":2170,"verse_start":7,"verse_end":7,"verse_label":"7","text":"Our soul has escaped like a bird out of the fowler’s snare. The snare is broken, and we have escaped.","is_omitted":0,"source_line":7331},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":124,"verse_ordinal":2171,"verse_start":8,"verse_end":8,"verse_label":"8","text":"Our help is in the LORD’s name, who made heaven and earth.","is_omitted":0,"source_line":7334}]}