{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":108,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":108,"verse_ordinal":1804,"verse_start":1,"verse_end":1,"verse_label":"1","text":"My heart is steadfast, God. I will sing and I will make music with my soul.","is_omitted":0,"source_line":6168},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":108,"verse_ordinal":1805,"verse_start":2,"verse_end":2,"verse_label":"2","text":"Wake up, harp and lyre! I will wake up the dawn.","is_omitted":0,"source_line":6171},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":108,"verse_ordinal":1806,"verse_start":3,"verse_end":3,"verse_label":"3","text":"I will give thanks to you, LORD, among the nations. I will sing praises to you among the peoples.","is_omitted":0,"source_line":6174},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":108,"verse_ordinal":1807,"verse_start":4,"verse_end":4,"verse_label":"4","text":"For your loving kindness is great above the heavens. Your faithfulness reaches to the skies.","is_omitted":0,"source_line":6177},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":108,"verse_ordinal":1808,"verse_start":5,"verse_end":5,"verse_label":"5","text":"Be exalted, God, above the heavens! Let your glory be over all the earth.","is_omitted":0,"source_line":6180},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":108,"verse_ordinal":1809,"verse_start":6,"verse_end":6,"verse_label":"6","text":"That your beloved may be delivered, save with your right hand, and answer us.","is_omitted":0,"source_line":6183},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":108,"verse_ordinal":1810,"verse_start":7,"verse_end":7,"verse_label":"7","text":"God has spoken from his sanctuary: “In triumph, I will divide Shechem, and measure out the valley of Succoth.","is_omitted":0,"source_line":6186},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":108,"verse_ordinal":1811,"verse_start":8,"verse_end":8,"verse_label":"8","text":"Gilead is mine. Manasseh is mine. Ephraim also is my helmet. Judah is my scepter.","is_omitted":0,"source_line":6189},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":108,"verse_ordinal":1812,"verse_start":9,"verse_end":9,"verse_label":"9","text":"Moab is my wash pot. I will toss my sandal on Edom. I will shout over Philistia.”","is_omitted":0,"source_line":6193},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":108,"verse_ordinal":1813,"verse_start":10,"verse_end":10,"verse_label":"10","text":"Who will bring me into the fortified city? Who will lead me to Edom?","is_omitted":0,"source_line":6197},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":108,"verse_ordinal":1814,"verse_start":11,"verse_end":11,"verse_label":"11","text":"Haven’t you rejected us, God? You don’t go out, God, with our armies.","is_omitted":0,"source_line":6200},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":108,"verse_ordinal":1815,"verse_start":12,"verse_end":12,"verse_label":"12","text":"Give us help against the enemy, for the help of man is vain.","is_omitted":0,"source_line":6203},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":108,"verse_ordinal":1816,"verse_start":13,"verse_end":13,"verse_label":"13","text":"Through God, we will do valiantly, for it is he who will tread down our enemies.","is_omitted":0,"source_line":6206}]}