{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:job","chapter":25,"verses":[{"translation_id":"engwebu","book_id":"engwebu:job","chapter":25,"verse_ordinal":593,"verse_start":1,"verse_end":1,"verse_label":"1","text":"Then Bildad the Shuhite answered,","is_omitted":0,"source_line":1884},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":25,"verse_ordinal":594,"verse_start":2,"verse_end":2,"verse_label":"2","text":"“Dominion and fear are with him. He makes peace in his high places.","is_omitted":0,"source_line":1886},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":25,"verse_ordinal":595,"verse_start":3,"verse_end":3,"verse_label":"3","text":"Can his armies be counted? On whom does his light not arise?","is_omitted":0,"source_line":1889},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":25,"verse_ordinal":596,"verse_start":4,"verse_end":4,"verse_label":"4","text":"How then can man be just with God? Or how can he who is born of a woman be clean?","is_omitted":0,"source_line":1892},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":25,"verse_ordinal":597,"verse_start":5,"verse_end":5,"verse_label":"5","text":"Behold, even the moon has no brightness, and the stars are not pure in his sight;","is_omitted":0,"source_line":1895},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":25,"verse_ordinal":598,"verse_start":6,"verse_end":6,"verse_label":"6","text":"How much less man, who is a worm, and the son of man, who is a worm!”","is_omitted":0,"source_line":1898}]}