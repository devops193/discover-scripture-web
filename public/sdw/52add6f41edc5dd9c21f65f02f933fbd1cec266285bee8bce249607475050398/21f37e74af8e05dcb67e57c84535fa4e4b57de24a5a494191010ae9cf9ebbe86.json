{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":93,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":93,"verse_ordinal":1488,"verse_start":1,"verse_end":1,"verse_label":"1","text":"The LORD reigns! He is clothed with majesty! The LORD is armed with strength. The world also is established. It can’t be moved.","is_omitted":0,"source_line":5120},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":93,"verse_ordinal":1489,"verse_start":2,"verse_end":2,"verse_label":"2","text":"Your throne is established from long ago. You are from everlasting.","is_omitted":0,"source_line":5126},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":93,"verse_ordinal":1490,"verse_start":3,"verse_end":3,"verse_label":"3","text":"The floods have lifted up, LORD, the floods have lifted up their voice. The floods lift up their waves.","is_omitted":0,"source_line":5129},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":93,"verse_ordinal":1491,"verse_start":4,"verse_end":4,"verse_label":"4","text":"Above the voices of many waters, the mighty breakers of the sea, the LORD on high is mighty.","is_omitted":0,"source_line":5133},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":93,"verse_ordinal":1492,"verse_start":5,"verse_end":5,"verse_label":"5","text":"Your statutes stand firm. Holiness adorns your house, LORD, forever more.","is_omitted":0,"source_line":5137}]}