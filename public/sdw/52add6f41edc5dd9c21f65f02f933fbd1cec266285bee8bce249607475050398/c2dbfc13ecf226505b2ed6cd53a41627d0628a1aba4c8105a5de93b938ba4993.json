{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":13,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":13,"verse_ordinal":136,"verse_start":1,"verse_end":1,"verse_label":"1","text":"How long, LORD? Will you forget me forever? How long will you hide your face from me?","is_omitted":0,"source_line":476},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":13,"verse_ordinal":137,"verse_start":2,"verse_end":2,"verse_label":"2","text":"How long shall I take counsel in my soul, having sorrow in my heart every day? How long shall my enemy triumph over me?","is_omitted":0,"source_line":480},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":13,"verse_ordinal":138,"verse_start":3,"verse_end":3,"verse_label":"3","text":"Behold, and answer me, LORD, my God. Give light to my eyes, lest I sleep in death;","is_omitted":0,"source_line":484},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":13,"verse_ordinal":139,"verse_start":4,"verse_end":4,"verse_label":"4","text":"lest my enemy say, “I have prevailed against him;” lest my adversaries rejoice when I fall.","is_omitted":0,"source_line":487},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":13,"verse_ordinal":140,"verse_start":5,"verse_end":5,"verse_label":"5","text":"But I trust in your loving kindness. My heart rejoices in your salvation.","is_omitted":0,"source_line":491},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":13,"verse_ordinal":141,"verse_start":6,"verse_end":6,"verse_label":"6","text":"I will sing to the LORD, because he has been good to me.","is_omitted":0,"source_line":494}]}