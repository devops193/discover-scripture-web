{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":131,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":131,"verse_ordinal":2210,"verse_start":1,"verse_end":1,"verse_label":"1","text":"LORD, my heart isn’t arrogant, nor my eyes lofty; nor do I concern myself with great matters, or things too wonderful for me.","is_omitted":0,"source_line":7471},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":131,"verse_ordinal":2211,"verse_start":2,"verse_end":2,"verse_label":"2","text":"Surely I have stilled and quieted my soul, like a weaned child with his mother, like a weaned child is my soul within me.","is_omitted":0,"source_line":7475},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":131,"verse_ordinal":2212,"verse_start":3,"verse_end":3,"verse_label":"3","text":"Israel, hope in the LORD, from this time forward and forever more.","is_omitted":0,"source_line":7479}]}