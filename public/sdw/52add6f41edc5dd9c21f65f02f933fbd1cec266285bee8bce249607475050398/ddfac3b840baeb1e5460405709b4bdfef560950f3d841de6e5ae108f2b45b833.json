{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":38,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":38,"verse_ordinal":552,"verse_start":1,"verse_end":1,"verse_label":"1","text":"LORD, don’t rebuke me in your wrath, neither chasten me in your hot displeasure.","is_omitted":0,"source_line":1910},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":38,"verse_ordinal":553,"verse_start":2,"verse_end":2,"verse_label":"2","text":"For your arrows have pierced me, your hand presses hard on me.","is_omitted":0,"source_line":1913},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":38,"verse_ordinal":554,"verse_start":3,"verse_end":3,"verse_label":"3","text":"There is no soundness in my flesh because of your indignation, neither is there any health in my bones because of my sin.","is_omitted":0,"source_line":1916},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":38,"verse_ordinal":555,"verse_start":4,"verse_end":4,"verse_label":"4","text":"For my iniquities have gone over my head. As a heavy burden, they are too heavy for me.","is_omitted":0,"source_line":1919},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":38,"verse_ordinal":556,"verse_start":5,"verse_end":5,"verse_label":"5","text":"My wounds are loathsome and corrupt because of my foolishness.","is_omitted":0,"source_line":1922},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":38,"verse_ordinal":557,"verse_start":6,"verse_end":6,"verse_label":"6","text":"I am in pain and bowed down greatly. I go mourning all day long.","is_omitted":0,"source_line":1925},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":38,"verse_ordinal":558,"verse_start":7,"verse_end":7,"verse_label":"7","text":"For my waist is filled with burning. There is no soundness in my flesh.","is_omitted":0,"source_line":1928},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":38,"verse_ordinal":559,"verse_start":8,"verse_end":8,"verse_label":"8","text":"I am faint and severely bruised. I have groaned by reason of the anguish of my heart.","is_omitted":0,"source_line":1931},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":38,"verse_ordinal":560,"verse_start":9,"verse_end":9,"verse_label":"9","text":"Lord, all my desire is before you. My groaning is not hidden from you.","is_omitted":0,"source_line":1934},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":38,"verse_ordinal":561,"verse_start":10,"verse_end":10,"verse_label":"10","text":"My heart throbs. My strength fails me. As for the light of my eyes, it has also left me.","is_omitted":0,"source_line":1937},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":38,"verse_ordinal":562,"verse_start":11,"verse_end":11,"verse_label":"11","text":"My lovers and my friends stand aloof from my plague. My kinsmen stand far away.","is_omitted":0,"source_line":1941},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":38,"verse_ordinal":563,"verse_start":12,"verse_end":12,"verse_label":"12","text":"They also who seek after my life lay snares. Those who seek my hurt speak mischievous things, and meditate deceits all day long.","is_omitted":0,"source_line":1944},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":38,"verse_ordinal":564,"verse_start":13,"verse_end":13,"verse_label":"13","text":"But I, as a deaf man, don’t hear. I am as a mute man who doesn’t open his mouth.","is_omitted":0,"source_line":1948},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":38,"verse_ordinal":565,"verse_start":14,"verse_end":14,"verse_label":"14","text":"Yes, I am as a man who doesn’t hear, in whose mouth are no reproofs.","is_omitted":0,"source_line":1951},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":38,"verse_ordinal":566,"verse_start":15,"verse_end":15,"verse_label":"15","text":"For I hope in you, LORD. You will answer, Lord my God.","is_omitted":0,"source_line":1954},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":38,"verse_ordinal":567,"verse_start":16,"verse_end":16,"verse_label":"16","text":"For I said, “Don’t let them gloat over me, or exalt themselves over me when my foot slips.”","is_omitted":0,"source_line":1957},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":38,"verse_ordinal":568,"verse_start":17,"verse_end":17,"verse_label":"17","text":"For I am ready to fall. My pain is continually before me.","is_omitted":0,"source_line":1960},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":38,"verse_ordinal":569,"verse_start":18,"verse_end":18,"verse_label":"18","text":"For I will declare my iniquity. I will be sorry for my sin.","is_omitted":0,"source_line":1963},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":38,"verse_ordinal":570,"verse_start":19,"verse_end":19,"verse_label":"19","text":"But my enemies are vigorous and many. Those who hate me without reason are numerous.","is_omitted":0,"source_line":1966},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":38,"verse_ordinal":571,"verse_start":20,"verse_end":20,"verse_label":"20","text":"They who give evil for good are also adversaries to me, because I follow what is good.","is_omitted":0,"source_line":1969},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":38,"verse_ordinal":572,"verse_start":21,"verse_end":21,"verse_label":"21","text":"Don’t forsake me, LORD. My God, don’t be far from me.","is_omitted":0,"source_line":1972},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":38,"verse_ordinal":573,"verse_start":22,"verse_end":22,"verse_label":"22","text":"Hurry to help me, Lord, my salvation.","is_omitted":0,"source_line":1975}]}