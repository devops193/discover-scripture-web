{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":116,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":116,"verse_ordinal":1910,"verse_start":1,"verse_end":1,"verse_label":"1","text":"I love the LORD, because he listens to my voice, and my cries for mercy.","is_omitted":0,"source_line":6513},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":116,"verse_ordinal":1911,"verse_start":2,"verse_end":2,"verse_label":"2","text":"Because he has turned his ear to me, therefore I will call on him as long as I live.","is_omitted":0,"source_line":6516},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":116,"verse_ordinal":1912,"verse_start":3,"verse_end":3,"verse_label":"3","text":"The cords of death surrounded me, the pains of Sheol got a hold of me. I found trouble and sorrow.","is_omitted":0,"source_line":6519},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":116,"verse_ordinal":1913,"verse_start":4,"verse_end":4,"verse_label":"4","text":"Then I called on the LORD’s name: “LORD, I beg you, deliver my soul.”","is_omitted":0,"source_line":6523},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":116,"verse_ordinal":1914,"verse_start":5,"verse_end":5,"verse_label":"5","text":"The LORD is gracious and righteous. Yes, our God is merciful.","is_omitted":0,"source_line":6526},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":116,"verse_ordinal":1915,"verse_start":6,"verse_end":6,"verse_label":"6","text":"The LORD preserves the simple. I was brought low, and he saved me.","is_omitted":0,"source_line":6529},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":116,"verse_ordinal":1916,"verse_start":7,"verse_end":7,"verse_label":"7","text":"Return to your rest, my soul, for the LORD has dealt bountifully with you.","is_omitted":0,"source_line":6532},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":116,"verse_ordinal":1917,"verse_start":8,"verse_end":8,"verse_label":"8","text":"For you have delivered my soul from death, my eyes from tears, and my feet from falling.","is_omitted":0,"source_line":6535},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":116,"verse_ordinal":1918,"verse_start":9,"verse_end":9,"verse_label":"9","text":"I will walk before the LORD in the land of the living.","is_omitted":0,"source_line":6539},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":116,"verse_ordinal":1919,"verse_start":10,"verse_end":10,"verse_label":"10","text":"I believed, therefore I said, “I was greatly afflicted.”","is_omitted":0,"source_line":6541},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":116,"verse_ordinal":1920,"verse_start":11,"verse_end":11,"verse_label":"11","text":"I said in my haste, “All people are liars.”","is_omitted":0,"source_line":6544},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":116,"verse_ordinal":1921,"verse_start":12,"verse_end":12,"verse_label":"12","text":"What will I give to the LORD for all his benefits toward me?","is_omitted":0,"source_line":6547},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":116,"verse_ordinal":1922,"verse_start":13,"verse_end":13,"verse_label":"13","text":"I will take the cup of salvation, and call on the LORD’s name.","is_omitted":0,"source_line":6549},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":116,"verse_ordinal":1923,"verse_start":14,"verse_end":14,"verse_label":"14","text":"I will pay my vows to the LORD, yes, in the presence of all his people.","is_omitted":0,"source_line":6551},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":116,"verse_ordinal":1924,"verse_start":15,"verse_end":15,"verse_label":"15","text":"Precious in the LORD’s sight is the death of his saints.","is_omitted":0,"source_line":6554},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":116,"verse_ordinal":1925,"verse_start":16,"verse_end":16,"verse_label":"16","text":"LORD, truly I am your servant. I am your servant, the son of your servant girl. You have freed me from my chains.","is_omitted":0,"source_line":6556},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":116,"verse_ordinal":1926,"verse_start":17,"verse_end":17,"verse_label":"17","text":"I will offer to you the sacrifice of thanksgiving, and will call on the LORD’s name.","is_omitted":0,"source_line":6560},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":116,"verse_ordinal":1927,"verse_start":18,"verse_end":18,"verse_label":"18","text":"I will pay my vows to the LORD, yes, in the presence of all his people,","is_omitted":0,"source_line":6563},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":116,"verse_ordinal":1928,"verse_start":19,"verse_end":19,"verse_label":"19","text":"in the courts of the LORD’s house, in the middle of you, Jerusalem. Praise the LORD!","is_omitted":0,"source_line":6566}]}