{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":135,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":135,"verse_ordinal":2237,"verse_start":1,"verse_end":1,"verse_label":"1","text":"Praise the LORD! Praise the LORD’s name! Praise him, you servants of the LORD,","is_omitted":0,"source_line":7566},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":135,"verse_ordinal":2238,"verse_start":2,"verse_end":2,"verse_label":"2","text":"you who stand in the LORD’s house, in the courts of our God’s house.","is_omitted":0,"source_line":7570},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":135,"verse_ordinal":2239,"verse_start":3,"verse_end":3,"verse_label":"3","text":"Praise the LORD, for the LORD is good. Sing praises to his name, for that is pleasant.","is_omitted":0,"source_line":7573},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":135,"verse_ordinal":2240,"verse_start":4,"verse_end":4,"verse_label":"4","text":"For the LORD has chosen Jacob for himself, Israel for his own possession.","is_omitted":0,"source_line":7576},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":135,"verse_ordinal":2241,"verse_start":5,"verse_end":5,"verse_label":"5","text":"For I know that the LORD is great, that our Lord is above all gods.","is_omitted":0,"source_line":7579},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":135,"verse_ordinal":2242,"verse_start":6,"verse_end":6,"verse_label":"6","text":"Whatever the LORD pleased, that he has done, in heaven and in earth, in the seas and in all deeps.","is_omitted":0,"source_line":7582},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":135,"verse_ordinal":2243,"verse_start":7,"verse_end":7,"verse_label":"7","text":"He causes the clouds to rise from the ends of the earth. He makes lightnings with the rain. He brings the wind out of his treasuries.","is_omitted":0,"source_line":7585},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":135,"verse_ordinal":2244,"verse_start":8,"verse_end":8,"verse_label":"8","text":"He struck the firstborn of Egypt, both of man and animal.","is_omitted":0,"source_line":7589},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":135,"verse_ordinal":2245,"verse_start":9,"verse_end":9,"verse_label":"9","text":"He sent signs and wonders into the middle of you, Egypt, on Pharaoh, and on all his servants.","is_omitted":0,"source_line":7592},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":135,"verse_ordinal":2246,"verse_start":10,"verse_end":10,"verse_label":"10","text":"He struck many nations, and killed mighty kings—","is_omitted":0,"source_line":7595},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":135,"verse_ordinal":2247,"verse_start":11,"verse_end":11,"verse_label":"11","text":"Sihon king of the Amorites, Og king of Bashan, and all the kingdoms of Canaan—","is_omitted":0,"source_line":7598},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":135,"verse_ordinal":2248,"verse_start":12,"verse_end":12,"verse_label":"12","text":"and gave their land for a heritage, a heritage to Israel, his people.","is_omitted":0,"source_line":7602},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":135,"verse_ordinal":2249,"verse_start":13,"verse_end":13,"verse_label":"13","text":"Your name, LORD, endures forever; your renown, LORD, throughout all generations.","is_omitted":0,"source_line":7605},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":135,"verse_ordinal":2250,"verse_start":14,"verse_end":14,"verse_label":"14","text":"For the LORD will judge his people and have compassion on his servants.","is_omitted":0,"source_line":7608},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":135,"verse_ordinal":2251,"verse_start":15,"verse_end":15,"verse_label":"15","text":"The idols of the nations are silver and gold, the work of men’s hands.","is_omitted":0,"source_line":7612},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":135,"verse_ordinal":2252,"verse_start":16,"verse_end":16,"verse_label":"16","text":"They have mouths, but they can’t speak. They have eyes, but they can’t see.","is_omitted":0,"source_line":7615},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":135,"verse_ordinal":2253,"verse_start":17,"verse_end":17,"verse_label":"17","text":"They have ears, but they can’t hear, neither is there any breath in their mouths.","is_omitted":0,"source_line":7618},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":135,"verse_ordinal":2254,"verse_start":18,"verse_end":18,"verse_label":"18","text":"Those who make them will be like them, yes, everyone who trusts in them.","is_omitted":0,"source_line":7621},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":135,"verse_ordinal":2255,"verse_start":19,"verse_end":19,"verse_label":"19","text":"House of Israel, praise the LORD! House of Aaron, praise the LORD!","is_omitted":0,"source_line":7624},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":135,"verse_ordinal":2256,"verse_start":20,"verse_end":20,"verse_label":"20","text":"House of Levi, praise the LORD! You who fear the LORD, praise the LORD!","is_omitted":0,"source_line":7627},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":135,"verse_ordinal":2257,"verse_start":21,"verse_end":21,"verse_label":"21","text":"Blessed be the LORD from Zion, who dwells in Jerusalem. Praise the LORD!","is_omitted":0,"source_line":7630}]}