{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:pro","chapter":2,"verses":[{"translation_id":"engwebu","book_id":"engwebu:pro","chapter":2,"verse_ordinal":34,"verse_start":1,"verse_end":1,"verse_label":"1","text":"My son, if you will receive my words, and store up my commandments within you,","is_omitted":0,"source_line":114},{"translation_id":"engwebu","book_id":"engwebu:pro","chapter":2,"verse_ordinal":35,"verse_start":2,"verse_end":2,"verse_label":"2","text":"so as to turn your ear to wisdom, and apply your heart to understanding;","is_omitted":0,"source_line":117},{"translation_id":"engwebu","book_id":"engwebu:pro","chapter":2,"verse_ordinal":36,"verse_start":3,"verse_end":3,"verse_label":"3","text":"yes, if you call out for discernment, and lift up your voice for understanding;","is_omitted":0,"source_line":120},{"translation_id":"engwebu","book_id":"engwebu:pro","chapter":2,"verse_ordinal":37,"verse_start":4,"verse_end":4,"verse_label":"4","text":"if you seek her as silver, and search for her as for hidden treasures;","is_omitted":0,"source_line":123},{"translation_id":"engwebu","book_id":"engwebu:pro","chapter":2,"verse_ordinal":38,"verse_start":5,"verse_end":5,"verse_label":"5","text":"then you will understand the fear of the LORD, and find the knowledge of God.","is_omitted":0,"source_line":126},{"translation_id":"engwebu","book_id":"engwebu:pro","chapter":2,"verse_ordinal":39,"verse_start":6,"verse_end":6,"verse_label":"6","text":"For the LORD gives wisdom. Out of his mouth comes knowledge and understanding.","is_omitted":0,"source_line":129},{"translation_id":"engwebu","book_id":"engwebu:pro","chapter":2,"verse_ordinal":40,"verse_start":7,"verse_end":7,"verse_label":"7","text":"He lays up sound wisdom for the upright. He is a shield to those who walk in integrity,","is_omitted":0,"source_line":132},{"translation_id":"engwebu","book_id":"engwebu:pro","chapter":2,"verse_ordinal":41,"verse_start":8,"verse_end":8,"verse_label":"8","text":"that he may guard the paths of justice, and preserve the way of his saints.","is_omitted":0,"source_line":135},{"translation_id":"engwebu","book_id":"engwebu:pro","chapter":2,"verse_ordinal":42,"verse_start":9,"verse_end":9,"verse_label":"9","text":"Then you will understand righteousness and justice, equity and every good path.","is_omitted":0,"source_line":138},{"translation_id":"engwebu","book_id":"engwebu:pro","chapter":2,"verse_ordinal":43,"verse_start":10,"verse_end":10,"verse_label":"10","text":"For wisdom will enter into your heart. Knowledge will be pleasant to your soul.","is_omitted":0,"source_line":141},{"translation_id":"engwebu","book_id":"engwebu:pro","chapter":2,"verse_ordinal":44,"verse_start":11,"verse_end":11,"verse_label":"11","text":"Discretion will watch over you. Understanding will keep you,","is_omitted":0,"source_line":144},{"translation_id":"engwebu","book_id":"engwebu:pro","chapter":2,"verse_ordinal":45,"verse_start":12,"verse_end":12,"verse_label":"12","text":"to deliver you from the way of evil, from the men who speak perverse things,","is_omitted":0,"source_line":147},{"translation_id":"engwebu","book_id":"engwebu:pro","chapter":2,"verse_ordinal":46,"verse_start":13,"verse_end":13,"verse_label":"13","text":"who forsake the paths of uprightness, to walk in the ways of darkness,","is_omitted":0,"source_line":150},{"translation_id":"engwebu","book_id":"engwebu:pro","chapter":2,"verse_ordinal":47,"verse_start":14,"verse_end":14,"verse_label":"14","text":"who rejoice to do evil, and delight in the perverseness of evil,","is_omitted":0,"source_line":153},{"translation_id":"engwebu","book_id":"engwebu:pro","chapter":2,"verse_ordinal":48,"verse_start":15,"verse_end":15,"verse_label":"15","text":"who are crooked in their ways, and wayward in their paths,","is_omitted":0,"source_line":156},{"translation_id":"engwebu","book_id":"engwebu:pro","chapter":2,"verse_ordinal":49,"verse_start":16,"verse_end":16,"verse_label":"16","text":"to deliver you from the strange woman, even from the foreigner who flatters with her words,","is_omitted":0,"source_line":159},{"translation_id":"engwebu","book_id":"engwebu:pro","chapter":2,"verse_ordinal":50,"verse_start":17,"verse_end":17,"verse_label":"17","text":"who forsakes the friend of her youth, and forgets the covenant of her God;","is_omitted":0,"source_line":162},{"translation_id":"engwebu","book_id":"engwebu:pro","chapter":2,"verse_ordinal":51,"verse_start":18,"verse_end":18,"verse_label":"18","text":"for her house leads down to death, her paths to the departed spirits.","is_omitted":0,"source_line":165},{"translation_id":"engwebu","book_id":"engwebu:pro","chapter":2,"verse_ordinal":52,"verse_start":19,"verse_end":19,"verse_label":"19","text":"None who go to her return again, neither do they attain to the paths of life.","is_omitted":0,"source_line":168},{"translation_id":"engwebu","book_id":"engwebu:pro","chapter":2,"verse_ordinal":53,"verse_start":20,"verse_end":20,"verse_label":"20","text":"Therefore walk in the way of good men, and keep the paths of the righteous.","is_omitted":0,"source_line":171},{"translation_id":"engwebu","book_id":"engwebu:pro","chapter":2,"verse_ordinal":54,"verse_start":21,"verse_end":21,"verse_label":"21","text":"For the upright will dwell in the land. The perfect will remain in it.","is_omitted":0,"source_line":174},{"translation_id":"engwebu","book_id":"engwebu:pro","chapter":2,"verse_ordinal":55,"verse_start":22,"verse_end":22,"verse_label":"22","text":"But the wicked will be cut off from the land. The treacherous will be rooted out of it.","is_omitted":0,"source_line":177}]}