{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":100,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":100,"verse_ordinal":1570,"verse_start":1,"verse_end":1,"verse_label":"1","text":"Shout for joy to the LORD, all you lands!","is_omitted":0,"source_line":5406},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":100,"verse_ordinal":1571,"verse_start":2,"verse_end":2,"verse_label":"2","text":"Serve the LORD with gladness. Come before his presence with singing.","is_omitted":0,"source_line":5408},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":100,"verse_ordinal":1572,"verse_start":3,"verse_end":3,"verse_label":"3","text":"Know that the LORD, he is God. It is he who has made us, and we are his. We are his people, and the sheep of his pasture.","is_omitted":0,"source_line":5411},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":100,"verse_ordinal":1573,"verse_start":4,"verse_end":4,"verse_label":"4","text":"Enter into his gates with thanksgiving, and into his courts with praise. Give thanks to him, and bless his name.","is_omitted":0,"source_line":5415},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":100,"verse_ordinal":1574,"verse_start":5,"verse_end":5,"verse_label":"5","text":"For the LORD is good. His loving kindness endures forever, his faithfulness to all generations.","is_omitted":0,"source_line":5419}]}