{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":85,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":85,"verse_ordinal":1333,"verse_start":1,"verse_end":1,"verse_label":"1","text":"LORD, you have been favorable to your land. You have restored the fortunes of Jacob.","is_omitted":0,"source_line":4615},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":85,"verse_ordinal":1334,"verse_start":2,"verse_end":2,"verse_label":"2","text":"You have forgiven the iniquity of your people. You have covered all their sin. Selah.","is_omitted":0,"source_line":4618},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":85,"verse_ordinal":1335,"verse_start":3,"verse_end":3,"verse_label":"3","text":"You have taken away all your wrath. You have turned from the fierceness of your anger.","is_omitted":0,"source_line":4621},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":85,"verse_ordinal":1336,"verse_start":4,"verse_end":4,"verse_label":"4","text":"Turn us, God of our salvation, and cause your indignation toward us to cease.","is_omitted":0,"source_line":4624},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":85,"verse_ordinal":1337,"verse_start":5,"verse_end":5,"verse_label":"5","text":"Will you be angry with us forever? Will you draw out your anger to all generations?","is_omitted":0,"source_line":4627},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":85,"verse_ordinal":1338,"verse_start":6,"verse_end":6,"verse_label":"6","text":"Won’t you revive us again, that your people may rejoice in you?","is_omitted":0,"source_line":4630},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":85,"verse_ordinal":1339,"verse_start":7,"verse_end":7,"verse_label":"7","text":"Show us your loving kindness, LORD. Grant us your salvation.","is_omitted":0,"source_line":4633},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":85,"verse_ordinal":1340,"verse_start":8,"verse_end":8,"verse_label":"8","text":"I will hear what God, the LORD, will speak, for he will speak peace to his people, his saints; but let them not turn again to folly.","is_omitted":0,"source_line":4636},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":85,"verse_ordinal":1341,"verse_start":9,"verse_end":9,"verse_label":"9","text":"Surely his salvation is near those who fear him, that glory may dwell in our land.","is_omitted":0,"source_line":4640},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":85,"verse_ordinal":1342,"verse_start":10,"verse_end":10,"verse_label":"10","text":"Mercy and truth meet together. Righteousness and peace have kissed each other.","is_omitted":0,"source_line":4643},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":85,"verse_ordinal":1343,"verse_start":11,"verse_end":11,"verse_label":"11","text":"Truth springs out of the earth. Righteousness has looked down from heaven.","is_omitted":0,"source_line":4646},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":85,"verse_ordinal":1344,"verse_start":12,"verse_end":12,"verse_label":"12","text":"Yes, the LORD will give that which is good. Our land will yield its increase.","is_omitted":0,"source_line":4649},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":85,"verse_ordinal":1345,"verse_start":13,"verse_end":13,"verse_label":"13","text":"Righteousness goes before him, and prepares the way for his steps.","is_omitted":0,"source_line":4652}]}