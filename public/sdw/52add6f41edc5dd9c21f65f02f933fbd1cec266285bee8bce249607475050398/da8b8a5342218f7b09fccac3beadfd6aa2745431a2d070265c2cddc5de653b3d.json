{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":126,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":126,"verse_ordinal":2177,"verse_start":1,"verse_end":1,"verse_label":"1","text":"When the LORD brought back those who returned to Zion, we were like those who dream.","is_omitted":0,"source_line":7357},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":126,"verse_ordinal":2178,"verse_start":2,"verse_end":2,"verse_label":"2","text":"Then our mouth was filled with laughter, and our tongue with singing. Then they said among the nations, “The LORD has done great things for them.”","is_omitted":0,"source_line":7360},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":126,"verse_ordinal":2179,"verse_start":3,"verse_end":3,"verse_label":"3","text":"The LORD has done great things for us, and we are glad.","is_omitted":0,"source_line":7365},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":126,"verse_ordinal":2180,"verse_start":4,"verse_end":4,"verse_label":"4","text":"Restore our fortunes again, LORD, like the streams in the Negev.","is_omitted":0,"source_line":7368},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":126,"verse_ordinal":2181,"verse_start":5,"verse_end":5,"verse_label":"5","text":"Those who sow in tears will reap in joy.","is_omitted":0,"source_line":7371},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":126,"verse_ordinal":2182,"verse_start":6,"verse_end":6,"verse_label":"6","text":"He who goes out weeping, carrying seed for sowing, will certainly come again with joy, carrying his sheaves.","is_omitted":0,"source_line":7373}]}