{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:job","chapter":26,"verses":[{"translation_id":"engwebu","book_id":"engwebu:job","chapter":26,"verse_ordinal":599,"verse_start":1,"verse_end":1,"verse_label":"1","text":"Then Job answered,","is_omitted":0,"source_line":1902},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":26,"verse_ordinal":600,"verse_start":2,"verse_end":2,"verse_label":"2","text":"“How have you helped him who is without power! How have you saved the arm that has no strength!","is_omitted":0,"source_line":1904},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":26,"verse_ordinal":601,"verse_start":3,"verse_end":3,"verse_label":"3","text":"How have you counseled him who has no wisdom, and plentifully declared sound knowledge!","is_omitted":0,"source_line":1907},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":26,"verse_ordinal":602,"verse_start":4,"verse_end":4,"verse_label":"4","text":"To whom have you uttered words? Whose spirit came out of you?","is_omitted":0,"source_line":1910},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":26,"verse_ordinal":603,"verse_start":5,"verse_end":5,"verse_label":"5","text":"“The departed spirits tremble, those beneath the waters and all that live in them.","is_omitted":0,"source_line":1914},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":26,"verse_ordinal":604,"verse_start":6,"verse_end":6,"verse_label":"6","text":"Sheol is naked before God, and Abaddon has no covering.","is_omitted":0,"source_line":1917},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":26,"verse_ordinal":605,"verse_start":7,"verse_end":7,"verse_label":"7","text":"He stretches out the north over empty space, and hangs the earth on nothing.","is_omitted":0,"source_line":1920},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":26,"verse_ordinal":606,"verse_start":8,"verse_end":8,"verse_label":"8","text":"He binds up the waters in his thick clouds, and the cloud is not burst under them.","is_omitted":0,"source_line":1923},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":26,"verse_ordinal":607,"verse_start":9,"verse_end":9,"verse_label":"9","text":"He encloses the face of his throne, and spreads his cloud on it.","is_omitted":0,"source_line":1926},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":26,"verse_ordinal":608,"verse_start":10,"verse_end":10,"verse_label":"10","text":"He has described a boundary on the surface of the waters, and to the confines of light and darkness.","is_omitted":0,"source_line":1929},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":26,"verse_ordinal":609,"verse_start":11,"verse_end":11,"verse_label":"11","text":"The pillars of heaven tremble and are astonished at his rebuke.","is_omitted":0,"source_line":1932},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":26,"verse_ordinal":610,"verse_start":12,"verse_end":12,"verse_label":"12","text":"He stirs up the sea with his power, and by his understanding he strikes through Rahab.","is_omitted":0,"source_line":1935},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":26,"verse_ordinal":611,"verse_start":13,"verse_end":13,"verse_label":"13","text":"By his Spirit the heavens are garnished. His hand has pierced the swift serpent.","is_omitted":0,"source_line":1938},{"translation_id":"engwebu","book_id":"engwebu:job","chapter":26,"verse_ordinal":612,"verse_start":14,"verse_end":14,"verse_label":"14","text":"Behold, these are but the outskirts of his ways. How small a whisper do we hear of him! But the thunder of his power who can understand?”","is_omitted":0,"source_line":1941}]}