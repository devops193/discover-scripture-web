{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:lam","chapter":3,"verses":[{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":45,"verse_start":1,"verse_end":1,"verse_label":"1","text":"I am the man who has seen affliction by the rod of his wrath.","is_omitted":0,"source_line":309},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":46,"verse_start":2,"verse_end":2,"verse_label":"2","text":"He has led me and caused me to walk in darkness, and not in light.","is_omitted":0,"source_line":312},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":47,"verse_start":3,"verse_end":3,"verse_label":"3","text":"Surely he turns his hand against me again and again all day long.","is_omitted":0,"source_line":315},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":48,"verse_start":4,"verse_end":4,"verse_label":"4","text":"He has made my flesh and my skin old. He has broken my bones.","is_omitted":0,"source_line":319},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":49,"verse_start":5,"verse_end":5,"verse_label":"5","text":"He has built against me, and surrounded me with bitterness and hardship.","is_omitted":0,"source_line":322},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":50,"verse_start":6,"verse_end":6,"verse_label":"6","text":"He has made me dwell in dark places, as those who have been long dead.","is_omitted":0,"source_line":325},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":51,"verse_start":7,"verse_end":7,"verse_label":"7","text":"He has walled me about, so that I can’t go out. He has made my chain heavy.","is_omitted":0,"source_line":329},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":52,"verse_start":8,"verse_end":8,"verse_label":"8","text":"Yes, when I cry, and call for help, he shuts out my prayer.","is_omitted":0,"source_line":332},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":53,"verse_start":9,"verse_end":9,"verse_label":"9","text":"He has walled up my ways with cut stone. He has made my paths crooked.","is_omitted":0,"source_line":335},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":54,"verse_start":10,"verse_end":10,"verse_label":"10","text":"He is to me as a bear lying in wait, as a lion in hiding.","is_omitted":0,"source_line":339},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":55,"verse_start":11,"verse_end":11,"verse_label":"11","text":"He has turned away my path, and pulled me in pieces. He has made me desolate.","is_omitted":0,"source_line":342},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":56,"verse_start":12,"verse_end":12,"verse_label":"12","text":"He has bent his bow, and set me as a mark for the arrow.","is_omitted":0,"source_line":346},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":57,"verse_start":13,"verse_end":13,"verse_label":"13","text":"He has caused the shafts of his quiver to enter into my kidneys.","is_omitted":0,"source_line":350},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":58,"verse_start":14,"verse_end":14,"verse_label":"14","text":"I have become a derision to all my people, and their song all day long.","is_omitted":0,"source_line":352},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":59,"verse_start":15,"verse_end":15,"verse_label":"15","text":"He has filled me with bitterness. He has stuffed me with wormwood.","is_omitted":0,"source_line":355},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":60,"verse_start":16,"verse_end":16,"verse_label":"16","text":"He has also broken my teeth with gravel. He has covered me with ashes.","is_omitted":0,"source_line":359},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":61,"verse_start":17,"verse_end":17,"verse_label":"17","text":"You have removed my soul far away from peace. I forgot prosperity.","is_omitted":0,"source_line":362},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":62,"verse_start":18,"verse_end":18,"verse_label":"18","text":"I said, “My strength has perished, along with my expectation from the LORD.”","is_omitted":0,"source_line":365},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":63,"verse_start":19,"verse_end":19,"verse_label":"19","text":"Remember my affliction and my misery, the wormwood and the bitterness.","is_omitted":0,"source_line":369},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":64,"verse_start":20,"verse_end":20,"verse_label":"20","text":"My soul still remembers them, and is bowed down within me.","is_omitted":0,"source_line":372},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":65,"verse_start":21,"verse_end":21,"verse_label":"21","text":"This I recall to my mind; therefore I have hope.","is_omitted":0,"source_line":375},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":66,"verse_start":22,"verse_end":22,"verse_label":"22","text":"It is because of the LORD’s loving kindnesses that we are not consumed, because his mercies don’t fail.","is_omitted":0,"source_line":379},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":67,"verse_start":23,"verse_end":23,"verse_label":"23","text":"They are new every morning. Great is your faithfulness.","is_omitted":0,"source_line":382},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":68,"verse_start":24,"verse_end":24,"verse_label":"24","text":"“The LORD is my portion,” says my soul. “Therefore I will hope in him.”","is_omitted":0,"source_line":385},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":69,"verse_start":25,"verse_end":25,"verse_label":"25","text":"The LORD is good to those who wait for him, to the soul who seeks him.","is_omitted":0,"source_line":389},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":70,"verse_start":26,"verse_end":26,"verse_label":"26","text":"It is good that a man should hope and quietly wait for the salvation of the LORD.","is_omitted":0,"source_line":392},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":71,"verse_start":27,"verse_end":27,"verse_label":"27","text":"It is good for a man that he bear the yoke in his youth.","is_omitted":0,"source_line":395},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":72,"verse_start":28,"verse_end":28,"verse_label":"28","text":"Let him sit alone and keep silence, because he has laid it on him.","is_omitted":0,"source_line":398},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":73,"verse_start":29,"verse_end":29,"verse_label":"29","text":"Let him put his mouth in the dust, if it is so that there may be hope.","is_omitted":0,"source_line":401},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":74,"verse_start":30,"verse_end":30,"verse_label":"30","text":"Let him give his cheek to him who strikes him. Let him be filled full of reproach.","is_omitted":0,"source_line":404},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":75,"verse_start":31,"verse_end":31,"verse_label":"31","text":"For the Lord will not cast off forever.","is_omitted":0,"source_line":408},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":76,"verse_start":32,"verse_end":32,"verse_label":"32","text":"For though he causes grief, yet he will have compassion according to the multitude of his loving kindnesses.","is_omitted":0,"source_line":410},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":77,"verse_start":33,"verse_end":33,"verse_label":"33","text":"For he does not afflict willingly, nor grieve the children of men.","is_omitted":0,"source_line":413},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":78,"verse_start":34,"verse_end":34,"verse_label":"34","text":"To crush under foot all the prisoners of the earth,","is_omitted":0,"source_line":417},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":79,"verse_start":35,"verse_end":35,"verse_label":"35","text":"to turn away the right of a man before the face of the Most High,","is_omitted":0,"source_line":419},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":80,"verse_start":36,"verse_end":36,"verse_label":"36","text":"to subvert a man in his cause, the Lord doesn’t approve.","is_omitted":0,"source_line":421},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":81,"verse_start":37,"verse_end":37,"verse_label":"37","text":"Who is he who says, and it comes to pass, when the Lord doesn’t command it?","is_omitted":0,"source_line":424},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":82,"verse_start":38,"verse_end":38,"verse_label":"38","text":"Doesn’t evil and good come out of the mouth of the Most High?","is_omitted":0,"source_line":427},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":83,"verse_start":39,"verse_end":39,"verse_label":"39","text":"Why should a living man complain, a man for the punishment of his sins?","is_omitted":0,"source_line":429},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":84,"verse_start":40,"verse_end":40,"verse_label":"40","text":"Let us search and try our ways, and turn again to the LORD.","is_omitted":0,"source_line":433},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":85,"verse_start":41,"verse_end":41,"verse_label":"41","text":"Let’s lift up our heart with our hands to God in the heavens.","is_omitted":0,"source_line":436},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":86,"verse_start":42,"verse_end":42,"verse_label":"42","text":"“We have transgressed and have rebelled. You have not pardoned.","is_omitted":0,"source_line":438},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":87,"verse_start":43,"verse_end":43,"verse_label":"43","text":"“You have covered us with anger and pursued us. You have killed. You have not pitied.","is_omitted":0,"source_line":442},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":88,"verse_start":44,"verse_end":44,"verse_label":"44","text":"You have covered yourself with a cloud, so that no prayer can pass through.","is_omitted":0,"source_line":446},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":89,"verse_start":45,"verse_end":45,"verse_label":"45","text":"You have made us an off-scouring and refuse in the middle of the peoples.","is_omitted":0,"source_line":449},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":90,"verse_start":46,"verse_end":46,"verse_label":"46","text":"“All our enemies have opened their mouth wide against us.","is_omitted":0,"source_line":453},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":91,"verse_start":47,"verse_end":47,"verse_label":"47","text":"Terror and the pit have come on us, devastation and destruction.”","is_omitted":0,"source_line":455},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":92,"verse_start":48,"verse_end":48,"verse_label":"48","text":"My eye runs down with streams of water, for the destruction of the daughter of my people.","is_omitted":0,"source_line":459},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":93,"verse_start":49,"verse_end":49,"verse_label":"49","text":"My eye pours down and doesn’t cease, without any intermission,","is_omitted":0,"source_line":462},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":94,"verse_start":50,"verse_end":50,"verse_label":"50","text":"until the LORD looks down, and sees from heaven.","is_omitted":0,"source_line":466},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":95,"verse_start":51,"verse_end":51,"verse_label":"51","text":"My eye affects my soul, because of all the daughters of my city.","is_omitted":0,"source_line":469},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":96,"verse_start":52,"verse_end":52,"verse_label":"52","text":"They have chased me relentlessly like a bird, those who are my enemies without cause.","is_omitted":0,"source_line":473},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":97,"verse_start":53,"verse_end":53,"verse_label":"53","text":"They have cut off my life in the dungeon, and have cast a stone on me.","is_omitted":0,"source_line":476},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":98,"verse_start":54,"verse_end":54,"verse_label":"54","text":"Waters flowed over my head. I said, “I am cut off.”","is_omitted":0,"source_line":479},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":99,"verse_start":55,"verse_end":55,"verse_label":"55","text":"I called on your name, LORD, out of the lowest dungeon.","is_omitted":0,"source_line":483},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":100,"verse_start":56,"verse_end":56,"verse_label":"56","text":"You heard my voice: “Don’t hide your ear from my sighing, and my cry.”","is_omitted":0,"source_line":486},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":101,"verse_start":57,"verse_end":57,"verse_label":"57","text":"You came near in the day that I called on you. You said, “Don’t be afraid.”","is_omitted":0,"source_line":491},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":102,"verse_start":58,"verse_end":58,"verse_label":"58","text":"Lord, you have pleaded the causes of my soul. You have redeemed my life.","is_omitted":0,"source_line":495},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":103,"verse_start":59,"verse_end":59,"verse_label":"59","text":"LORD, you have seen my wrong. Judge my cause.","is_omitted":0,"source_line":498},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":104,"verse_start":60,"verse_end":60,"verse_label":"60","text":"You have seen all their vengeance and all their plans against me.","is_omitted":0,"source_line":501},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":105,"verse_start":61,"verse_end":61,"verse_label":"61","text":"You have heard their reproach, LORD, and all their plans against me,","is_omitted":0,"source_line":505},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":106,"verse_start":62,"verse_end":62,"verse_label":"62","text":"the lips of those that rose up against me, and their plots against me all day long.","is_omitted":0,"source_line":508},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":107,"verse_start":63,"verse_end":63,"verse_label":"63","text":"You see their sitting down and their rising up. I am their song.","is_omitted":0,"source_line":511},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":108,"verse_start":64,"verse_end":64,"verse_label":"64","text":"You will pay them back, LORD, according to the work of their hands.","is_omitted":0,"source_line":515},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":109,"verse_start":65,"verse_end":65,"verse_label":"65","text":"You will give them hardness of heart, your curse to them.","is_omitted":0,"source_line":518},{"translation_id":"engwebu","book_id":"engwebu:lam","chapter":3,"verse_ordinal":110,"verse_start":66,"verse_end":66,"verse_label":"66","text":"You will pursue them in anger, and destroy them from under the heavens of the LORD.","is_omitted":0,"source_line":521}]}