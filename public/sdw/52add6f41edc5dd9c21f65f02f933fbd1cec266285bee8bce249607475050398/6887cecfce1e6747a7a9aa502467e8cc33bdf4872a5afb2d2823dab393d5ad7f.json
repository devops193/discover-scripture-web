{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":118,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1931,"verse_start":1,"verse_end":1,"verse_label":"1","text":"Give thanks to the LORD, for he is good, for his loving kindness endures forever.","is_omitted":0,"source_line":6579},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1932,"verse_start":2,"verse_end":2,"verse_label":"2","text":"Let Israel now say that his loving kindness endures forever.","is_omitted":0,"source_line":6582},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1933,"verse_start":3,"verse_end":3,"verse_label":"3","text":"Let the house of Aaron now say that his loving kindness endures forever.","is_omitted":0,"source_line":6585},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1934,"verse_start":4,"verse_end":4,"verse_label":"4","text":"Now let those who fear the LORD say that his loving kindness endures forever.","is_omitted":0,"source_line":6588},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1935,"verse_start":5,"verse_end":5,"verse_label":"5","text":"Out of my distress, I called on the LORD. The LORD answered me with freedom.","is_omitted":0,"source_line":6591},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1936,"verse_start":6,"verse_end":6,"verse_label":"6","text":"The LORD is on my side. I will not be afraid. What can man do to me?","is_omitted":0,"source_line":6594},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1937,"verse_start":7,"verse_end":7,"verse_label":"7","text":"The LORD is on my side among those who help me. Therefore I will look in triumph at those who hate me.","is_omitted":0,"source_line":6597},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1938,"verse_start":8,"verse_end":8,"verse_label":"8","text":"It is better to take refuge in the LORD, than to put confidence in man.","is_omitted":0,"source_line":6600},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1939,"verse_start":9,"verse_end":9,"verse_label":"9","text":"It is better to take refuge in the LORD, than to put confidence in princes.","is_omitted":0,"source_line":6603},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1940,"verse_start":10,"verse_end":10,"verse_label":"10","text":"All the nations surrounded me, but in the LORD’s name I cut them off.","is_omitted":0,"source_line":6606},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1941,"verse_start":11,"verse_end":11,"verse_label":"11","text":"They surrounded me, yes, they surrounded me. In the LORD’s name I indeed cut them off.","is_omitted":0,"source_line":6609},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1942,"verse_start":12,"verse_end":12,"verse_label":"12","text":"They surrounded me like bees. They are quenched like the burning thorns. In the LORD’s name I cut them off.","is_omitted":0,"source_line":6612},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1943,"verse_start":13,"verse_end":13,"verse_label":"13","text":"You pushed me back hard, to make me fall, but the LORD helped me.","is_omitted":0,"source_line":6616},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1944,"verse_start":14,"verse_end":14,"verse_label":"14","text":"The LORD is my strength and song. He has become my salvation.","is_omitted":0,"source_line":6619},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1945,"verse_start":15,"verse_end":15,"verse_label":"15","text":"The voice of rejoicing and salvation is in the tents of the righteous. “The right hand of the LORD does valiantly.","is_omitted":0,"source_line":6622},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1946,"verse_start":16,"verse_end":16,"verse_label":"16","text":"The right hand of the LORD is exalted! The right hand of the LORD does valiantly!”","is_omitted":0,"source_line":6625},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1947,"verse_start":17,"verse_end":17,"verse_label":"17","text":"I will not die, but live, and declare the LORD’s works.","is_omitted":0,"source_line":6628},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1948,"verse_start":18,"verse_end":18,"verse_label":"18","text":"The LORD has punished me severely, but he has not given me over to death.","is_omitted":0,"source_line":6631},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1949,"verse_start":19,"verse_end":19,"verse_label":"19","text":"Open to me the gates of righteousness. I will enter into them. I will give thanks to the LORD.","is_omitted":0,"source_line":6634},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1950,"verse_start":20,"verse_end":20,"verse_label":"20","text":"This is the gate of the LORD; the righteous will enter into it.","is_omitted":0,"source_line":6638},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1951,"verse_start":21,"verse_end":21,"verse_label":"21","text":"I will give thanks to you, for you have answered me, and have become my salvation.","is_omitted":0,"source_line":6641},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1952,"verse_start":22,"verse_end":22,"verse_label":"22","text":"The stone which the builders rejected has become the cornerstone.","is_omitted":0,"source_line":6644},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1953,"verse_start":23,"verse_end":23,"verse_label":"23","text":"This is the LORD’s doing. It is marvelous in our eyes.","is_omitted":0,"source_line":6647},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1954,"verse_start":24,"verse_end":24,"verse_label":"24","text":"This is the day that the LORD has made. We will rejoice and be glad in it!","is_omitted":0,"source_line":6650},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1955,"verse_start":25,"verse_end":25,"verse_label":"25","text":"Save us now, we beg you, LORD! LORD, we beg you, send prosperity now.","is_omitted":0,"source_line":6653},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1956,"verse_start":26,"verse_end":26,"verse_label":"26","text":"Blessed is he who comes in the LORD’s name! We have blessed you out of the LORD’s house.","is_omitted":0,"source_line":6656},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1957,"verse_start":27,"verse_end":27,"verse_label":"27","text":"The LORD is God, and he has given us light. Bind the sacrifice with cords, even to the horns of the altar.","is_omitted":0,"source_line":6659},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1958,"verse_start":28,"verse_end":28,"verse_label":"28","text":"You are my God, and I will give thanks to you. You are my God, I will exalt you.","is_omitted":0,"source_line":6662},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":118,"verse_ordinal":1959,"verse_start":29,"verse_end":29,"verse_label":"29","text":"Oh give thanks to the LORD, for he is good, for his loving kindness endures forever.","is_omitted":0,"source_line":6665}]}