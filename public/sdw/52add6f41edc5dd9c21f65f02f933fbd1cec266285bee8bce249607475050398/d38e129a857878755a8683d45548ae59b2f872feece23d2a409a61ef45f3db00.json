{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":132,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":132,"verse_ordinal":2213,"verse_start":1,"verse_end":1,"verse_label":"1","text":"LORD, remember David and all his affliction,","is_omitted":0,"source_line":7484},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":132,"verse_ordinal":2214,"verse_start":2,"verse_end":2,"verse_label":"2","text":"how he swore to the LORD, and vowed to the Mighty One of Jacob:","is_omitted":0,"source_line":7486},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":132,"verse_ordinal":2215,"verse_start":3,"verse_end":3,"verse_label":"3","text":"“Surely I will not come into the structure of my house, nor go up into my bed;","is_omitted":0,"source_line":7489},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":132,"verse_ordinal":2216,"verse_start":4,"verse_end":4,"verse_label":"4","text":"I will not give sleep to my eyes, or slumber to my eyelids,","is_omitted":0,"source_line":7492},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":132,"verse_ordinal":2217,"verse_start":5,"verse_end":5,"verse_label":"5","text":"until I find out a place for the LORD, a dwelling for the Mighty One of Jacob.”","is_omitted":0,"source_line":7495},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":132,"verse_ordinal":2218,"verse_start":6,"verse_end":6,"verse_label":"6","text":"Behold, we heard of it in Ephrathah. We found it in the field of Jaar.","is_omitted":0,"source_line":7498},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":132,"verse_ordinal":2219,"verse_start":7,"verse_end":7,"verse_label":"7","text":"“We will go into his dwelling place. We will worship at his footstool.”","is_omitted":0,"source_line":7501},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":132,"verse_ordinal":2220,"verse_start":8,"verse_end":8,"verse_label":"8","text":"Arise, LORD, into your resting place, you, and the ark of your strength.","is_omitted":0,"source_line":7504},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":132,"verse_ordinal":2221,"verse_start":9,"verse_end":9,"verse_label":"9","text":"Let your priests be clothed with righteousness. Let your saints shout for joy!","is_omitted":0,"source_line":7507},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":132,"verse_ordinal":2222,"verse_start":10,"verse_end":10,"verse_label":"10","text":"For your servant David’s sake, don’t turn away the face of your anointed one.","is_omitted":0,"source_line":7510},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":132,"verse_ordinal":2223,"verse_start":11,"verse_end":11,"verse_label":"11","text":"The LORD has sworn to David in truth. He will not turn from it: “I will set the fruit of your body on your throne.","is_omitted":0,"source_line":7513},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":132,"verse_ordinal":2224,"verse_start":12,"verse_end":12,"verse_label":"12","text":"If your children will keep my covenant, my testimony that I will teach them, their children also will sit on your throne forever more.”","is_omitted":0,"source_line":7517},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":132,"verse_ordinal":2225,"verse_start":13,"verse_end":13,"verse_label":"13","text":"For the LORD has chosen Zion. He has desired it for his habitation.","is_omitted":0,"source_line":7521},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":132,"verse_ordinal":2226,"verse_start":14,"verse_end":14,"verse_label":"14","text":"“This is my resting place forever. I will live here, for I have desired it.","is_omitted":0,"source_line":7524},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":132,"verse_ordinal":2227,"verse_start":15,"verse_end":15,"verse_label":"15","text":"I will abundantly bless her provision. I will satisfy her poor with bread.","is_omitted":0,"source_line":7527},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":132,"verse_ordinal":2228,"verse_start":16,"verse_end":16,"verse_label":"16","text":"I will also clothe her priests with salvation. Her saints will shout aloud for joy.","is_omitted":0,"source_line":7530},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":132,"verse_ordinal":2229,"verse_start":17,"verse_end":17,"verse_label":"17","text":"I will make the horn of David to bud there. I have ordained a lamp for my anointed.","is_omitted":0,"source_line":7533},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":132,"verse_ordinal":2230,"verse_start":18,"verse_end":18,"verse_label":"18","text":"I will clothe his enemies with shame, but on himself, his crown will shine.”","is_omitted":0,"source_line":7536}]}