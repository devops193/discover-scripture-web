{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":88,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":88,"verse_ordinal":1370,"verse_start":1,"verse_end":1,"verse_label":"1","text":"LORD, the God of my salvation, I have cried day and night before you.","is_omitted":0,"source_line":4735},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":88,"verse_ordinal":1371,"verse_start":2,"verse_end":2,"verse_label":"2","text":"Let my prayer enter into your presence. Turn your ear to my cry.","is_omitted":0,"source_line":4738},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":88,"verse_ordinal":1372,"verse_start":3,"verse_end":3,"verse_label":"3","text":"For my soul is full of troubles. My life draws near to Sheol.","is_omitted":0,"source_line":4741},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":88,"verse_ordinal":1373,"verse_start":4,"verse_end":4,"verse_label":"4","text":"I am counted among those who go down into the pit. I am like a man who has no help,","is_omitted":0,"source_line":4744},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":88,"verse_ordinal":1374,"verse_start":5,"verse_end":5,"verse_label":"5","text":"set apart among the dead, like the slain who lie in the grave, whom you remember no more. They are cut off from your hand.","is_omitted":0,"source_line":4747},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":88,"verse_ordinal":1375,"verse_start":6,"verse_end":6,"verse_label":"6","text":"You have laid me in the lowest pit, in the darkest depths.","is_omitted":0,"source_line":4752},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":88,"verse_ordinal":1376,"verse_start":7,"verse_end":7,"verse_label":"7","text":"Your wrath lies heavily on me. You have afflicted me with all your waves. Selah.","is_omitted":0,"source_line":4755},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":88,"verse_ordinal":1377,"verse_start":8,"verse_end":8,"verse_label":"8","text":"You have taken my friends from me. You have made me an abomination to them. I am confined, and I can’t escape.","is_omitted":0,"source_line":4758},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":88,"verse_ordinal":1378,"verse_start":9,"verse_end":9,"verse_label":"9","text":"My eyes are dim from grief. I have called on you daily, LORD. I have spread out my hands to you.","is_omitted":0,"source_line":4762},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":88,"verse_ordinal":1379,"verse_start":10,"verse_end":10,"verse_label":"10","text":"Do you show wonders to the dead? Do the departed spirits rise up and praise you? Selah.","is_omitted":0,"source_line":4766},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":88,"verse_ordinal":1380,"verse_start":11,"verse_end":11,"verse_label":"11","text":"Is your loving kindness declared in the grave? Or your faithfulness in Destruction?","is_omitted":0,"source_line":4769},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":88,"verse_ordinal":1381,"verse_start":12,"verse_end":12,"verse_label":"12","text":"Are your wonders made known in the dark? Or your righteousness in the land of forgetfulness?","is_omitted":0,"source_line":4772},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":88,"verse_ordinal":1382,"verse_start":13,"verse_end":13,"verse_label":"13","text":"But to you, LORD, I have cried. In the morning, my prayer comes before you.","is_omitted":0,"source_line":4775},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":88,"verse_ordinal":1383,"verse_start":14,"verse_end":14,"verse_label":"14","text":"LORD, why do you reject my soul? Why do you hide your face from me?","is_omitted":0,"source_line":4778},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":88,"verse_ordinal":1384,"verse_start":15,"verse_end":15,"verse_label":"15","text":"I am afflicted and ready to die from my youth up. While I suffer your terrors, I am distracted.","is_omitted":0,"source_line":4781},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":88,"verse_ordinal":1385,"verse_start":16,"verse_end":16,"verse_label":"16","text":"Your fierce wrath has gone over me. Your terrors have cut me off.","is_omitted":0,"source_line":4784},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":88,"verse_ordinal":1386,"verse_start":17,"verse_end":17,"verse_label":"17","text":"They came around me like water all day long. They completely engulfed me.","is_omitted":0,"source_line":4787},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":88,"verse_ordinal":1387,"verse_start":18,"verse_end":18,"verse_label":"18","text":"You have put lover and friend far from me, and my friends into darkness.","is_omitted":0,"source_line":4790}]}