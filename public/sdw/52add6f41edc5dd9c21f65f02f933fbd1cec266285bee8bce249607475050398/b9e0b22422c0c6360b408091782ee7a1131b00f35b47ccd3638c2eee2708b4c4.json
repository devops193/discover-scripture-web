{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":120,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":120,"verse_ordinal":2136,"verse_start":1,"verse_end":1,"verse_label":"1","text":"In my distress, I cried to the LORD. He answered me.","is_omitted":0,"source_line":7220},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":120,"verse_ordinal":2137,"verse_start":2,"verse_end":2,"verse_label":"2","text":"Deliver my soul, LORD, from lying lips, from a deceitful tongue.","is_omitted":0,"source_line":7223},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":120,"verse_ordinal":2138,"verse_start":3,"verse_end":3,"verse_label":"3","text":"What will be given to you, and what will be done more to you, you deceitful tongue?","is_omitted":0,"source_line":7226},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":120,"verse_ordinal":2139,"verse_start":4,"verse_end":4,"verse_label":"4","text":"Sharp arrows of the mighty, with coals of juniper.","is_omitted":0,"source_line":7229},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":120,"verse_ordinal":2140,"verse_start":5,"verse_end":5,"verse_label":"5","text":"Woe is me, that I live in Meshech, that I dwell among the tents of Kedar!","is_omitted":0,"source_line":7232},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":120,"verse_ordinal":2141,"verse_start":6,"verse_end":6,"verse_label":"6","text":"My soul has had her dwelling too long with him who hates peace.","is_omitted":0,"source_line":7235},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":120,"verse_ordinal":2142,"verse_start":7,"verse_end":7,"verse_label":"7","text":"I am for peace, but when I speak, they are for war.","is_omitted":0,"source_line":7238}]}