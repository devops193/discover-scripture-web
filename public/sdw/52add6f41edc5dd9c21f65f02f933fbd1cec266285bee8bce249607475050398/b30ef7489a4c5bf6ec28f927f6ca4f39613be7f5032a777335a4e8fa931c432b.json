{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":147,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":147,"verse_ordinal":2413,"verse_start":1,"verse_end":1,"verse_label":"1","text":"Praise the LORD, for it is good to sing praises to our God; for it is pleasant and fitting to praise him.","is_omitted":0,"source_line":8173},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":147,"verse_ordinal":2414,"verse_start":2,"verse_end":2,"verse_label":"2","text":"The LORD builds up Jerusalem. He gathers together the outcasts of Israel.","is_omitted":0,"source_line":8177},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":147,"verse_ordinal":2415,"verse_start":3,"verse_end":3,"verse_label":"3","text":"He heals the broken in heart, and binds up their wounds.","is_omitted":0,"source_line":8180},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":147,"verse_ordinal":2416,"verse_start":4,"verse_end":4,"verse_label":"4","text":"He counts the number of the stars. He calls them all by their names.","is_omitted":0,"source_line":8183},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":147,"verse_ordinal":2417,"verse_start":5,"verse_end":5,"verse_label":"5","text":"Great is our Lord, and mighty in power. His understanding is infinite.","is_omitted":0,"source_line":8186},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":147,"verse_ordinal":2418,"verse_start":6,"verse_end":6,"verse_label":"6","text":"The LORD upholds the humble. He brings the wicked down to the ground.","is_omitted":0,"source_line":8189},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":147,"verse_ordinal":2419,"verse_start":7,"verse_end":7,"verse_label":"7","text":"Sing to the LORD with thanksgiving. Sing praises on the harp to our God,","is_omitted":0,"source_line":8192},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":147,"verse_ordinal":2420,"verse_start":8,"verse_end":8,"verse_label":"8","text":"who covers the sky with clouds, who prepares rain for the earth, who makes grass grow on the mountains.","is_omitted":0,"source_line":8195},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":147,"verse_ordinal":2421,"verse_start":9,"verse_end":9,"verse_label":"9","text":"He provides food for the livestock, and for the young ravens when they call.","is_omitted":0,"source_line":8199},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":147,"verse_ordinal":2422,"verse_start":10,"verse_end":10,"verse_label":"10","text":"He doesn’t delight in the strength of the horse. He takes no pleasure in the legs of a man.","is_omitted":0,"source_line":8202},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":147,"verse_ordinal":2423,"verse_start":11,"verse_end":11,"verse_label":"11","text":"The LORD takes pleasure in those who fear him, in those who hope in his loving kindness.","is_omitted":0,"source_line":8205},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":147,"verse_ordinal":2424,"verse_start":12,"verse_end":12,"verse_label":"12","text":"Praise the LORD, Jerusalem! Praise your God, Zion!","is_omitted":0,"source_line":8208},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":147,"verse_ordinal":2425,"verse_start":13,"verse_end":13,"verse_label":"13","text":"For he has strengthened the bars of your gates. He has blessed your children within you.","is_omitted":0,"source_line":8211},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":147,"verse_ordinal":2426,"verse_start":14,"verse_end":14,"verse_label":"14","text":"He makes peace in your borders. He fills you with the finest of the wheat.","is_omitted":0,"source_line":8214},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":147,"verse_ordinal":2427,"verse_start":15,"verse_end":15,"verse_label":"15","text":"He sends out his commandment to the earth. His word runs very swiftly.","is_omitted":0,"source_line":8217},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":147,"verse_ordinal":2428,"verse_start":16,"verse_end":16,"verse_label":"16","text":"He gives snow like wool, and scatters frost like ashes.","is_omitted":0,"source_line":8220},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":147,"verse_ordinal":2429,"verse_start":17,"verse_end":17,"verse_label":"17","text":"He hurls down his hail like pebbles. Who can stand before his cold?","is_omitted":0,"source_line":8223},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":147,"verse_ordinal":2430,"verse_start":18,"verse_end":18,"verse_label":"18","text":"He sends out his word, and melts them. He causes his wind to blow, and the waters flow.","is_omitted":0,"source_line":8226},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":147,"verse_ordinal":2431,"verse_start":19,"verse_end":19,"verse_label":"19","text":"He shows his word to Jacob, his statutes and his ordinances to Israel.","is_omitted":0,"source_line":8229},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":147,"verse_ordinal":2432,"verse_start":20,"verse_end":20,"verse_label":"20","text":"He has not done this for just any nation. They don’t know his ordinances. Praise the LORD!","is_omitted":0,"source_line":8232}]}