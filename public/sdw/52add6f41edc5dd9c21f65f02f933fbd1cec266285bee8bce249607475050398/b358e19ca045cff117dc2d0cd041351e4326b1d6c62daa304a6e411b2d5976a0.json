{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":128,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":128,"verse_ordinal":2188,"verse_start":1,"verse_end":1,"verse_label":"1","text":"Blessed is everyone who fears the LORD, who walks in his ways.","is_omitted":0,"source_line":7399},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":128,"verse_ordinal":2189,"verse_start":2,"verse_end":2,"verse_label":"2","text":"For you will eat the labor of your hands. You will be happy, and it will be well with you.","is_omitted":0,"source_line":7402},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":128,"verse_ordinal":2190,"verse_start":3,"verse_end":3,"verse_label":"3","text":"Your wife will be as a fruitful vine in the innermost parts of your house, your children like olive shoots around your table.","is_omitted":0,"source_line":7405},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":128,"verse_ordinal":2191,"verse_start":4,"verse_end":4,"verse_label":"4","text":"Behold, this is how the man who fears the LORD is blessed.","is_omitted":0,"source_line":7408},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":128,"verse_ordinal":2192,"verse_start":5,"verse_end":5,"verse_label":"5","text":"May the LORD bless you out of Zion, and may you see the good of Jerusalem all the days of your life.","is_omitted":0,"source_line":7410},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":128,"verse_ordinal":2193,"verse_start":6,"verse_end":6,"verse_label":"6","text":"Yes, may you see your children’s children. Peace be upon Israel.","is_omitted":0,"source_line":7413}]}