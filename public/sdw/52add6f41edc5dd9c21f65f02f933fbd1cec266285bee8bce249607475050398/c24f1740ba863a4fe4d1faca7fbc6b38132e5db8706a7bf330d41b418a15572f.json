{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":56,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":56,"verse_ordinal":817,"verse_start":1,"verse_end":1,"verse_label":"1","text":"Be merciful to me, God, for man wants to swallow me up. All day long, he attacks and oppresses me.","is_omitted":0,"source_line":2842},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":56,"verse_ordinal":818,"verse_start":2,"verse_end":2,"verse_label":"2","text":"My enemies want to swallow me up all day long, for they are many who fight proudly against me.","is_omitted":0,"source_line":2845},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":56,"verse_ordinal":819,"verse_start":3,"verse_end":3,"verse_label":"3","text":"When I am afraid, I will put my trust in you.","is_omitted":0,"source_line":2848},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":56,"verse_ordinal":820,"verse_start":4,"verse_end":4,"verse_label":"4","text":"In God, I praise his word. In God, I put my trust. I will not be afraid. What can flesh do to me?","is_omitted":0,"source_line":2851},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":56,"verse_ordinal":821,"verse_start":5,"verse_end":5,"verse_label":"5","text":"All day long they twist my words. All their thoughts are against me for evil.","is_omitted":0,"source_line":2856},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":56,"verse_ordinal":822,"verse_start":6,"verse_end":6,"verse_label":"6","text":"They conspire and lurk, watching my steps. They are eager to take my life.","is_omitted":0,"source_line":2859},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":56,"verse_ordinal":823,"verse_start":7,"verse_end":7,"verse_label":"7","text":"Shall they escape by iniquity? In anger cast down the peoples, God.","is_omitted":0,"source_line":2863},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":56,"verse_ordinal":824,"verse_start":8,"verse_end":8,"verse_label":"8","text":"You count my wanderings. You put my tears into your container. Aren’t they in your book?","is_omitted":0,"source_line":2866},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":56,"verse_ordinal":825,"verse_start":9,"verse_end":9,"verse_label":"9","text":"Then my enemies shall turn back in the day that I call. I know this: that God is for me.","is_omitted":0,"source_line":2870},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":56,"verse_ordinal":826,"verse_start":10,"verse_end":10,"verse_label":"10","text":"In God, I will praise his word. In the LORD, I will praise his word.","is_omitted":0,"source_line":2873},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":56,"verse_ordinal":827,"verse_start":11,"verse_end":11,"verse_label":"11","text":"I have put my trust in God. I will not be afraid. What can man do to me?","is_omitted":0,"source_line":2876},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":56,"verse_ordinal":828,"verse_start":12,"verse_end":12,"verse_label":"12","text":"Your vows are on me, God. I will give thank offerings to you.","is_omitted":0,"source_line":2880},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":56,"verse_ordinal":829,"verse_start":13,"verse_end":13,"verse_label":"13","text":"For you have delivered my soul from death, and prevented my feet from falling, that I may walk before God in the light of the living.","is_omitted":0,"source_line":2883}]}