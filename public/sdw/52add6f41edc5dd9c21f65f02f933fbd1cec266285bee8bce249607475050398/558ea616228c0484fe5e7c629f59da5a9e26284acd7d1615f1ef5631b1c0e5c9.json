{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":47,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":47,"verse_ordinal":687,"verse_start":1,"verse_end":1,"verse_label":"1","text":"Oh clap your hands, all you nations. Shout to God with the voice of triumph!","is_omitted":0,"source_line":2389},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":47,"verse_ordinal":688,"verse_start":2,"verse_end":2,"verse_label":"2","text":"For the LORD Most High is awesome. He is a great King over all the earth.","is_omitted":0,"source_line":2392},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":47,"verse_ordinal":689,"verse_start":3,"verse_end":3,"verse_label":"3","text":"He subdues nations under us, and peoples under our feet.","is_omitted":0,"source_line":2395},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":47,"verse_ordinal":690,"verse_start":4,"verse_end":4,"verse_label":"4","text":"He chooses our inheritance for us, the glory of Jacob whom he loved. Selah.","is_omitted":0,"source_line":2398},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":47,"verse_ordinal":691,"verse_start":5,"verse_end":5,"verse_label":"5","text":"God has gone up with a shout, the LORD with the sound of a trumpet.","is_omitted":0,"source_line":2401},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":47,"verse_ordinal":692,"verse_start":6,"verse_end":6,"verse_label":"6","text":"Sing praises to God! Sing praises! Sing praises to our King! Sing praises!","is_omitted":0,"source_line":2404},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":47,"verse_ordinal":693,"verse_start":7,"verse_end":7,"verse_label":"7","text":"For God is the King of all the earth. Sing praises with understanding.","is_omitted":0,"source_line":2407},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":47,"verse_ordinal":694,"verse_start":8,"verse_end":8,"verse_label":"8","text":"God reigns over the nations. God sits on his holy throne.","is_omitted":0,"source_line":2410},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":47,"verse_ordinal":695,"verse_start":9,"verse_end":9,"verse_label":"9","text":"The princes of the peoples are gathered together, the people of the God of Abraham. For the shields of the earth belong to God. He is greatly exalted!","is_omitted":0,"source_line":2413}]}