{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":70,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":70,"verse_ordinal":1033,"verse_start":1,"verse_end":1,"verse_label":"1","text":"Hurry, God, to deliver me. Come quickly to help me, LORD.","is_omitted":0,"source_line":3607},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":70,"verse_ordinal":1034,"verse_start":2,"verse_end":2,"verse_label":"2","text":"Let them be disappointed and confounded who seek my soul. Let those who desire my ruin be turned back in disgrace.","is_omitted":0,"source_line":3610},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":70,"verse_ordinal":1035,"verse_start":3,"verse_end":3,"verse_label":"3","text":"Let them be turned because of their shame who say, “Aha! Aha!”","is_omitted":0,"source_line":3613},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":70,"verse_ordinal":1036,"verse_start":4,"verse_end":4,"verse_label":"4","text":"Let all those who seek you rejoice and be glad in you. Let those who love your salvation continually say, “Let God be exalted!”","is_omitted":0,"source_line":3616},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":70,"verse_ordinal":1037,"verse_start":5,"verse_end":5,"verse_label":"5","text":"But I am poor and needy. Come to me quickly, God. You are my help and my deliverer. LORD, don’t delay.","is_omitted":0,"source_line":3620}]}