{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":25,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":25,"verse_ordinal":313,"verse_start":1,"verse_end":1,"verse_label":"1","text":"To you, LORD, I lift up my soul.","is_omitted":0,"source_line":1097},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":25,"verse_ordinal":314,"verse_start":2,"verse_end":2,"verse_label":"2","text":"My God, I have trusted in you. Don’t let me be shamed. Don’t let my enemies triumph over me.","is_omitted":0,"source_line":1099},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":25,"verse_ordinal":315,"verse_start":3,"verse_end":3,"verse_label":"3","text":"Yes, no one who waits for you will be shamed. They will be shamed who deal treacherously without cause.","is_omitted":0,"source_line":1103},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":25,"verse_ordinal":316,"verse_start":4,"verse_end":4,"verse_label":"4","text":"Show me your ways, LORD. Teach me your paths.","is_omitted":0,"source_line":1107},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":25,"verse_ordinal":317,"verse_start":5,"verse_end":5,"verse_label":"5","text":"Guide me in your truth, and teach me, for you are the God of my salvation. I wait for you all day long.","is_omitted":0,"source_line":1110},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":25,"verse_ordinal":318,"verse_start":6,"verse_end":6,"verse_label":"6","text":"LORD, remember your tender mercies and your loving kindness, for they are from old times.","is_omitted":0,"source_line":1114},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":25,"verse_ordinal":319,"verse_start":7,"verse_end":7,"verse_label":"7","text":"Don’t remember the sins of my youth, nor my transgressions. Remember me according to your loving kindness, for your goodness’ sake, LORD.","is_omitted":0,"source_line":1117},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":25,"verse_ordinal":320,"verse_start":8,"verse_end":8,"verse_label":"8","text":"Good and upright is the LORD, therefore he will instruct sinners in the way.","is_omitted":0,"source_line":1121},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":25,"verse_ordinal":321,"verse_start":9,"verse_end":9,"verse_label":"9","text":"He will guide the humble in justice. He will teach the humble his way.","is_omitted":0,"source_line":1124},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":25,"verse_ordinal":322,"verse_start":10,"verse_end":10,"verse_label":"10","text":"All the paths of the LORD are loving kindness and truth to such as keep his covenant and his testimonies.","is_omitted":0,"source_line":1127},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":25,"verse_ordinal":323,"verse_start":11,"verse_end":11,"verse_label":"11","text":"For your name’s sake, LORD, pardon my iniquity, for it is great.","is_omitted":0,"source_line":1130},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":25,"verse_ordinal":324,"verse_start":12,"verse_end":12,"verse_label":"12","text":"What man is he who fears the LORD? He shall instruct him in the way that he shall choose.","is_omitted":0,"source_line":1133},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":25,"verse_ordinal":325,"verse_start":13,"verse_end":13,"verse_label":"13","text":"His soul will dwell at ease. His offspring will inherit the land.","is_omitted":0,"source_line":1136},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":25,"verse_ordinal":326,"verse_start":14,"verse_end":14,"verse_label":"14","text":"The friendship of the LORD is with those who fear him. He will show them his covenant.","is_omitted":0,"source_line":1139},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":25,"verse_ordinal":327,"verse_start":15,"verse_end":15,"verse_label":"15","text":"My eyes are ever on the LORD, for he will pluck my feet out of the net.","is_omitted":0,"source_line":1143},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":25,"verse_ordinal":328,"verse_start":16,"verse_end":16,"verse_label":"16","text":"Turn to me, and have mercy on me, for I am desolate and afflicted.","is_omitted":0,"source_line":1146},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":25,"verse_ordinal":329,"verse_start":17,"verse_end":17,"verse_label":"17","text":"The troubles of my heart are enlarged. Oh bring me out of my distresses.","is_omitted":0,"source_line":1149},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":25,"verse_ordinal":330,"verse_start":18,"verse_end":18,"verse_label":"18","text":"Consider my affliction and my travail. Forgive all my sins.","is_omitted":0,"source_line":1152},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":25,"verse_ordinal":331,"verse_start":19,"verse_end":19,"verse_label":"19","text":"Consider my enemies, for they are many. They hate me with cruel hatred.","is_omitted":0,"source_line":1155},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":25,"verse_ordinal":332,"verse_start":20,"verse_end":20,"verse_label":"20","text":"Oh keep my soul, and deliver me. Let me not be disappointed, for I take refuge in you.","is_omitted":0,"source_line":1158},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":25,"verse_ordinal":333,"verse_start":21,"verse_end":21,"verse_label":"21","text":"Let integrity and uprightness preserve me, for I wait for you.","is_omitted":0,"source_line":1161},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":25,"verse_ordinal":334,"verse_start":22,"verse_end":22,"verse_label":"22","text":"God, redeem Israel out of all his troubles.","is_omitted":0,"source_line":1164}]}