{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":76,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":76,"verse_ordinal":1143,"verse_start":1,"verse_end":1,"verse_label":"1","text":"In Judah, God is known. His name is great in Israel.","is_omitted":0,"source_line":3979},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":76,"verse_ordinal":1144,"verse_start":2,"verse_end":2,"verse_label":"2","text":"His tabernacle is also in Salem. His dwelling place in Zion.","is_omitted":0,"source_line":3982},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":76,"verse_ordinal":1145,"verse_start":3,"verse_end":3,"verse_label":"3","text":"There he broke the flaming arrows of the bow, the shield, and the sword, and the weapons of war. Selah.","is_omitted":0,"source_line":3985},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":76,"verse_ordinal":1146,"verse_start":4,"verse_end":4,"verse_label":"4","text":"Glorious are you, and excellent, more than mountains of game.","is_omitted":0,"source_line":3988},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":76,"verse_ordinal":1147,"verse_start":5,"verse_end":5,"verse_label":"5","text":"Valiant men lie plundered, they have slept their last sleep. None of the men of war can lift their hands.","is_omitted":0,"source_line":3991},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":76,"verse_ordinal":1148,"verse_start":6,"verse_end":6,"verse_label":"6","text":"At your rebuke, God of Jacob, both chariot and horse are cast into a dead sleep.","is_omitted":0,"source_line":3995},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":76,"verse_ordinal":1149,"verse_start":7,"verse_end":7,"verse_label":"7","text":"You, even you, are to be feared. Who can stand in your sight when you are angry?","is_omitted":0,"source_line":3998},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":76,"verse_ordinal":1150,"verse_start":8,"verse_end":8,"verse_label":"8","text":"You pronounced judgment from heaven. The earth feared, and was silent,","is_omitted":0,"source_line":4001},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":76,"verse_ordinal":1151,"verse_start":9,"verse_end":9,"verse_label":"9","text":"when God arose to judgment, to save all the afflicted ones of the earth. Selah.","is_omitted":0,"source_line":4004},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":76,"verse_ordinal":1152,"verse_start":10,"verse_end":10,"verse_label":"10","text":"Surely the wrath of man praises you. The survivors of your wrath are restrained.","is_omitted":0,"source_line":4007},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":76,"verse_ordinal":1153,"verse_start":11,"verse_end":11,"verse_label":"11","text":"Make vows to the LORD your God, and fulfill them! Let all of his neighbors bring presents to him who is to be feared.","is_omitted":0,"source_line":4010},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":76,"verse_ordinal":1154,"verse_start":12,"verse_end":12,"verse_label":"12","text":"He will cut off the spirit of princes. He is feared by the kings of the earth.","is_omitted":0,"source_line":4013}]}