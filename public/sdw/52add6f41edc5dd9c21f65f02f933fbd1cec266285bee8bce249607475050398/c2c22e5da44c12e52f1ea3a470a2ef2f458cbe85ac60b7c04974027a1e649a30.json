{"schema":"SDW_SCRIPTURE_CHAPTER_V1","revision":"52add6f41edc5dd9c21f65f02f933fbd1cec266285bee8bce249607475050398","canonicalSourceHash":"f9dfbce6dd2edfe4bb3b4690acd6622f392035be2b0349df98f3607f0a05f6c2","bookId":"engwebu:psa","chapter":54,"verses":[{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":54,"verse_ordinal":787,"verse_start":1,"verse_end":1,"verse_label":"1","text":"Save me, God, by your name. Vindicate me in your might.","is_omitted":0,"source_line":2736},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":54,"verse_ordinal":788,"verse_start":2,"verse_end":2,"verse_label":"2","text":"Hear my prayer, God. Listen to the words of my mouth.","is_omitted":0,"source_line":2739},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":54,"verse_ordinal":789,"verse_start":3,"verse_end":3,"verse_label":"3","text":"For strangers have risen up against me. Violent men have sought after my soul. They haven’t set God before them. Selah.","is_omitted":0,"source_line":2742},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":54,"verse_ordinal":790,"verse_start":4,"verse_end":4,"verse_label":"4","text":"Behold, God is my helper. The Lord is the one who sustains my soul.","is_omitted":0,"source_line":2746},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":54,"verse_ordinal":791,"verse_start":5,"verse_end":5,"verse_label":"5","text":"He will repay the evil to my enemies. Destroy them in your truth.","is_omitted":0,"source_line":2749},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":54,"verse_ordinal":792,"verse_start":6,"verse_end":6,"verse_label":"6","text":"With a free will offering, I will sacrifice to you. I will give thanks to your name, LORD, for it is good.","is_omitted":0,"source_line":2752},{"translation_id":"engwebu","book_id":"engwebu:psa","chapter":54,"verse_ordinal":793,"verse_start":7,"verse_end":7,"verse_label":"7","text":"For he has delivered me out of all trouble. My eye has seen triumph over my enemies.","is_omitted":0,"source_line":2755}]}